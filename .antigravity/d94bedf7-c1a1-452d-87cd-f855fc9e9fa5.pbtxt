      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport {\n  Bot,\n  LayoutDashboard,\n  TrendingUp,\n  ArrowRight,\n  Briefcase,\n  Plus,\n  Folder,\n  Settings,\n  FileText,\n  MonitorSmartphone,\n  Sparkles,\n  Bold,\n  Italic,\n  Underline,\n  List,\n  ListOrdered,\n  Undo,\n  Redo,\n  Send,\n  User,\n  Loader2,\n  Database,\n  Target,\n  ShieldCheck,\n  AlertTriangle,\n  FileSearch,\n  CheckCircle2,\n  GitMerge,\n  Crosshair,\n  MessageSquareWarning,\n  ShieldAlert\n} from \'lucide-react\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\nconst COLORS = {\n  primary: \'#002045\',\n  primaryContainer: \'#1a365d\',\n  success: \'#38A169\',\n  warning: \'#D69E2E\',\n  background: \'#F8FAFC\',\n  surface: \'#FFFFFF\',\n  border: \'#E2E8F0\',\n  textSecondary: \'#64748b\',\n};\n\nconst SHADOW = \'shadow-[0_4px_6px_-1px_rgba(26,54,93,0.05),0_2px_4px_-1px_rgba(26,54,93,0.03)]\';\nconst HOVER_SHADOW = \'hover:shadow-[0_10px_15px_-3px_rgba(26,54,93,0.1),0_4px_6px_-2px_rgba(26,54,93,0.05)]\';\n\ntype ViewState = \'landing\' | \'dashboard\' | \'pipeline\' | \'editor\';\n\nconst LoadingOverlay = ({ message = \'\353\266\210\353\237\254\354\230\244\353\212\224 \354\244\221...\' }: { message?: string }) => (\n  <motion.div\n    initial={{ opacity: 0 }}\n    animate={{ opacity: 1 }}\n    exit={{ opacity: 0 }}\n    className=\"fixed inset-0 bg-white/80 backdrop-blur-sm z-50 flex flex-col items-center justify-center\"\n  >\n    <Loader2 className=\"w-12 h-12 text-[#002045] animate-spin mb-4\" />\n    <p className=\"text-[#002045] font-medium animate-pulse\">{message}</p>\n  </motion.div>\n);\n\n// --- 1. Landing View ---\nconst LandingView = ({ onNavigate }: { onNavigate: (view: ViewState) => void }) => {\n  return (\n    <div className=\"min-h-screen bg-[#F8FAFC] flex flex-col font-sans\">\n      <header className=\"w-full h-16 bg-white border-b border-[#E2E8F0] sticky top-0 z-40\">\n        <div className=\"max-w-7xl mx-auto px-6 h-full flex justify-between items-center\">\n          <div className=\"text-2xl font-bold text-[#002045] tracking-tight\">CareerCraft</div>\n          <nav className=\"hidden md:flex gap-8 items-center\">\n            <button onClick={() => onNavigate(\'dashboard\')} className=\"text-[#64748b] hover:text-[#002045] transition-colors font-medium\">\354\233\214\355\201\254\354\212\244\355\216\230\354\235\264\354\212\244</button>\n            <button onClick={() => onNavigate(\'editor\')} className=\"text-[#64748b] hover:text-[#002045] transition-colors font-medium\">\354\275\224\355\214\214\354\235\274\353\237\277 \354\227\220\353\224\224\355\204\260</button>\n          </nav>\n          <button className=\"text-[#002045] font-semibold hover:text-[#38A169] transition-colors\">\353\241\234\352\267\270\354\235\270</button>\n        </div>\n      </header>\n\n      <main className=\"flex-grow\">\n        <section className=\"py-24 px-6 max-w-5xl mx-auto text-center flex flex-col items-center\">\n          <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} className=\"inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#f0f3ff] text-[#1a365d] font-semibold text-sm mb-8\">\n            <ShieldCheck size={16} />\n            <span>Writing AI\352\260\200 \354\225\204\353\213\214, Evidence-based Application AI</span>\n          </motion.div>\n          <motion.h1 \n            initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}\n            className=\"text-4xl md:text-6xl font-bold text-[#002045] mb-6 tracking-tight leading-tight\"\n          >\n            \353\202\264 \352\262\275\355\227\230\354\235\204 \354\247\201\353\254\264\354\227\220 \353\247\236\353\212\224 \354\246\235\352\261\260\353\241\234 \353\260\224\352\276\270\353\212\224<br/>AI \354\267\250\354\227\205 \354\275\224\355\214\214\354\235\274\353\237\277.\n          </motion.h1>\n          <motion.p \n            initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.2 }}\n            className=\"text-lg md:text-xl text-[#64748b] max-w-3xl mb-10 leading-relaxed\"\n          >\n            \354\227\206\353\212\224 \352\262\275\355\227\230\354\235\204 \354\247\200\354\226\264\353\202\264\354\247\200 \354\225\212\354\212\265\353\213\210\353\213\244. \354\202\254\354\232\251\354\236\220\352\260\200 \354\235\264\353\257\270 \352\260\200\354\247\204 \352\262\275\355\227\230\354\235\204 \354\236\220\354\202\260\355\231\224\355\225\230\352\263\240, \n            \354\247\200\354\233\220 \354\247\201\353\254\264(JD)\354\227\220 \353\247\236\352\262\214 3C4P\353\241\234 \353\266\204\355\225\264\355\225\230\354\227\254 \353\251\264\354\240\221\354\227\220\354\204\234 \353\260\251\354\226\264 \352\260\200\353\212\245\355\225\234 \354\265\234\354\240\201\354\235\230 \354\247\200\354\233\220 \354\240\204\353\236\265\354\235\204 \354\260\276\354\225\204\354\244\215\353\213\210\353\213\244.\n          </motion.p>\n          <motion.div \n            initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}\n            className=\"flex gap-4 flex-col sm:flex-row\"\n          >\n            <button onClick={() => onNavigate(\'dashboard\')} className=\"bg-[#38A169] text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-opacity-90 transition-all shadow-sm flex items-center justify-center gap-2\">\n              <Database size={20} /> \353\202\264 \354\236\220\354\202\260\354\234\274\353\241\234 \354\213\234\354\236\221\355\225\230\352\270\260\n            </button>\n          </motion.div>\n        </section>\n\n        <section className=\"py-24 px-6 max-w-7xl mx-auto\">\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n            <div className={`bg-white border border-[#E2E8F0] rounded-xl p-8 ${SHADOW}`}>\n              <div className=\"w-12 h-12 rounded-lg bg-[#f0f3ff] text-[#1a365d] flex items-center justify-center mb-6\">\n                <GitMerge size={24} />\n              </div>\n              <h3 className=\"text-xl font-bold text-[#002045] mb-3\">JD \303\227 \352\262\275\355\227\230 \353\247\244\354\271\255</h3>\n              <p className=\"text-[#64748b] leading-relaxed\">\353\213\250\354\210\234 \354\236\221\354\204\261\354\235\264 \354\225\204\353\213\231\353\213\210\353\213\244. \354\261\204\354\232\251 \352\263\265\352\263\240\353\245\274 \353\266\204\354\204\235\355\225\230\354\227\254 \353\202\264 \352\262\275\355\227\230 \354\244\221 \352\260\200\354\236\245 \352\260\225\353\240\245\355\225\234 \'\355\225\204\354\202\264\352\270\260\', \'\353\260\211\354\202\264\352\270\260\', \'\353\271\214\354\202\264\352\270\260\' \354\206\214\354\236\254\353\245\274 \354\204\240\353\263\204\355\225\251\353\213\210\353\213\244.</p>\n            </div>\n            <div className={`bg-white border border-[#E2E8F0] rounded-xl p-8 ${SHADOW}`}>\n              <div className=\"w-12 h-12 rounded-lg bg-[#f0f3ff] text-[#1a365d] flex items-center justify-center mb-6\">\n                <Target size={24} />\n              </div>\n              <h3 className=\"text-xl font-bold text-[#002045] mb-3\">\354\210\253\354\236\220 \353\260\217 \352\267\274\352\261\260 \352\262\200\354\246\235</h3>\n              <p className=\"text-[#64748b] leading-relaxed\">\"\355\232\250\354\234\250 30% \354\246\235\352\260\200\"\353\235\274\353\212\224 \353\254\270\354\236\245\354\227\220 \354\233\220\353\263\270 \353\215\260\354\235\264\355\204\260 \352\267\274\352\261\260\352\260\200 \354\236\210\353\212\224\354\247\200 \354\266\224\354\240\201\355\225\251\353\213\210\353\213\244. \352\267\274\352\261\260 \354\227\206\353\212\224 \354\243\274\354\236\245\354\235\200 \353\260\260\354\240\234\355\225\230\354\227\254 \354\213\240\353\242\260\353\217\204\353\245\274 \353\206\222\354\236\205\353\213\210\353\213\244.</p>\n            </div>\n            <div className={`bg-white border border-[#E2E8F0] rounded-xl p-8 ${SHADOW}`}>\n              <div className=\"w-12 h-12 rounded-lg bg-[#f0f3ff] text-[#1a365d] flex items-center justify-center mb-6\">\n                <ShieldAlert size={24} />\n              </div>\n              <h3 className=\"text-xl font-bold text-[#002045] mb-3\">\353\251\264\354\240\221 \353\260\251\354\226\264 \355\205\214\354\212\244\355\212\270</h3>\n              <p className=\"text-[#64748b] leading-relaxed\">\354\236\221\354\204\261\353\220\234 \354\247\200\354\233\220\354\204\234\353\245\274 \353\260\224\355\203\225\354\234\274\353\241\234 AI\352\260\200 \353\251\264\354\240\221\352\264\200\354\262\230\353\237\274 \354\225\225\353\260\225 \354\247\210\353\254\270\354\235\204 \353\215\230\354\247\221\353\213\210\353\213\244. \353\260\251\354\226\264\355\225\240 \354\210\230 \354\227\206\353\212\224 \353\254\270\354\236\245\354\235\200 \354\202\254\354\240\204\354\227\220 \353\202\256\354\266\224\352\261\260\353\202\230 \354\240\234\352\261\260\355\225\251\353\213\210\353\213\244.</p>\n            </div>\n          </div>\n        </section>\n      </main>\n    </div>\n  );\n};\n\n// --- 2. Dashboard View (Candidate Vault & Pipelines) ---\nconst DashboardView = ({ onNavigate }: { onNavigate: (view: ViewState) => void }) => {\n  return (\n    <div className=\"min-h-screen bg-[#F8FAFC] flex font-sans\">\n      <aside className=\"hidden md:flex flex-col w-64 bg-white border-r border-[#E2E8F0] p-4 fixed h-full z-20\">\n        <div className=\"mb-8 px-2 flex items-center gap-3 cursor-pointer\" onClick={() => onNavigate(\'landing\')}>\n          <div className=\"w-10 h-10 rounded-lg bg-[#1a365d] text-white flex items-center justify-center\">\n            <Briefcase size={20} />\n          </div>\n          <div>\n            <h1 className=\"font-bold text-[#002045] leading-tight\">CareerCraft</h1>\n            <p className=\"text-xs text-[#64748b]\">Copilot v1.0</p>\n          </div>\n        </div>\n        \n        <button onClick={() => onNavigate(\'pipeline\')} className=\"mb-6 w-full py-3 bg-[#38A169] text-white rounded-lg font-semibold text-sm flex items-center justify-center gap-2 hover:bg-opacity-90 transition-colors shadow-sm\">\n          <Plus size={18} /> \354\203\210 \354\247\200\354\233\220 \355\214\214\354\235\264\355\224\204\353\235\274\354\235\270\n        </button>\n        \n        <nav className=\"flex flex-col gap-1\">\n          <a href=\"#\" className=\"flex items-center gap-3 bg-[#f0f3ff] text-[#1a365d] font-semibold rounded-lg px-4 py-3 text-sm\">\n            <LayoutDashboard size={18} /> \355\206\265\355\225\251 \353\214\200\354\213\234\353\263\264\353\223\234\n          </a>\n          <a href=\"#\" className=\"flex items-center gap-3 text-[#64748b] hover:bg-slate-50 rounded-lg px-4 py-3 text-sm font-medium transition-colors\">\n            <Database size={18} /> Candidate Vault\n          </a>\n          <a href=\"#\" className=\"flex items-center gap-3 text-[#64748b] hover:bg-slate-50 rounded-lg px-4 py-3 text-sm font-medium transition-colors\">\n            <FileText size={18} /> \354\247\200\354\233\220 \354\235\264\353\240\245\n          </a>\n        </nav>\n      </aside>\n\n      <main className=\"flex-1 md:ml-64 p-8\">\n        <div className=\"max-w-6xl mx-auto\">\n          <section className=\"mb-10 flex justify-between items-end\">\n            <div>\n              <h2 className=\"text-3xl font-bold text-[#002045] mb-2 tracking-tight\">\353\260\230\352\260\200\354\233\214\354\232\224, Alex\353\213\230.</h2>\n              <p className=\"text-[#64748b]\">\353\263\264\354\234\240\355\225\230\354\213\240 \352\262\275\355\227\230 \354\236\220\354\202\260\354\235\204 \353\260\224\355\203\225\354\234\274\353\241\234 \354\203\210\353\241\234\354\232\264 \352\270\260\355\232\214\353\245\274 \354\204\244\352\263\204\355\225\230\354\204\270\354\232\224.</p>\n            </div>\n          </section>\n\n          <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n            {/* Candidate Vault Overview */}\n            <div className=\"lg:col-span-1 flex flex-col gap-6\">\n              <div className={`bg-white border border-[#E2E8F0] rounded-xl p-6 ${SHADOW}`}>\n                <div className=\"flex items-center gap-3 mb-6\">\n                  <Database className=\"text-[#1a365d]\" size={24} />\n                  <h3 className=\"text-xl font-bold text-[#002045]\">Candidate Vault</h3>\n                </div>\n                <div className=\"space-y-4\">\n                  <div className=\"flex justify-between items-center p-3 bg-slate-50 rounded-lg\">\n                    <span className=\"text-sm font-medium text-[#64748b]\">\352\265\254\354\241\260\355\231\224\353\220\234 \352\262\275\355\227\230 (3C4P)</span>\n                    <span className=\"text-lg font-bold text-[#002045]\">12\352\260\234</span>\n                  </div>\n                  <div className=\"flex justify-between items-center p-3 bg-slate-50 rounded-lg\">\n                    <span className=\"text-sm font-medium text-[#64748b]\">\353\223\261\353\241\235\353\220\234 \354\235\264\353\240\245\354\204\234</span>\n                    <span className=\"text-lg font-bold text-[#002045]\">3\352\261\264</span>\n                  </div>\n                  <div className=\"flex justify-between items-center p-3 bg-slate-50 rounded-lg\">\n                    <span className=\"text-sm font-medium text-[#64748b]\">\355\217\254\355\212\270\355\217\264\353\246\254\354\230\244 \355\224\204\353\241\234\354\240\235\355\212\270</span>\n                    <span className=\"text-lg font-bold text-[#002045]\">5\352\261\264</span>\n                  </div>\n                </div>\n                <button className=\"w-full mt-6 py-2 border border-[#E2E8F0] text-[#002045] text-sm font-semibold rounded-lg hover:bg-slate-50\">\n                  \354\236\220\354\202\260 \354\227\205\353\215\260\354\235\264\355\212\270\355\225\230\352\270\260\n                </button>\n              </div>\n            </div>\n\n            {/* Active Pipelines */}\n            <div className=\"lg:col-span-2\">\n              <h3 className=\"text-xl font-bold text-[#002045] mb-4\">\354\247\204\355\226\211 \354\244\221\354\235\270 \354\247\200\354\233\220 \355\214\214\354\235\264\355\224\204\353\235\274\354\235\270</h3>\n              <div className=\"space-y-4\">\n                {/* Pipeline Card */}\n                <div onClick={() => onNavigate(\'editor\')} className={`bg-white border border-[#E2E8F0] rounded-xl p-6 cursor-pointer ${SHADOW} ${HOVER_SHADOW} transition-all`}>\n                  <div className=\"flex justify-between items-start mb-4\">\n                    <div>\n                      <span className=\"inline-block px-2 py-1 bg-[#f0f3ff] text-[#1a365d] text-xs font-bold rounded mb-2\">\354\275\230\355\205\220\354\270\240 \352\270\260\355\232\215 / \354\233\271\355\210\260 PD</span>\n                      <h4 className=\"font-bold text-[#002045] text-lg\">TechNova 2024 \355\225\230\353\260\230\352\270\260 \352\263\265\354\261\204</h4>\n                    </div>\n                    <span className=\"bg-[#38A169]/10 text-[#38A169] text-xs font-bold px-3 py-1.5 rounded-full flex items-center gap-1\">\n                      <ShieldCheck size={14} /> \353\260\251\354\226\264 \355\205\214\354\212\244\355\212\270 \354\244\221\n                    </span>\n                  </div>\n                  \n                  {/* Pipeline Visual */}\n                  <div className=\"flex items-center justify-between mt-8 relative\">\n                    <div className=\"absolute left-0 top-1/2 -translate-y-1/2 w-full h-1 bg-slate-100 -z-10 rounded-full\"></div>\n                    <div className=\"absolute left-0 top-1/2 -translate-y-1/2 w-[75%] h-1 bg-[#38A169] -z-10 rounded-full\"></div>\n                    \n                    {[\n                      { step: \'JD \353\266\204\354\204\235\', done: true },\n                      { step: \'\352\262\275\355\227\230 \353\247\244\354\271\255\', done: true },\n                      { step: \'\354\240\204\353\236\265 \354\266\224\354\262\234\', done: true },\n                      { step: \'\353\254\270\354\204\234 \354\203\235\354\204\261\', done: true },\n                      { step: \'\353\260\251\354\226\264 \352\262\200\354\246\235\', done: false },\n                    ].map((s, i) => (\n                      <div key={i} className=\"flex flex-col items-center gap-2\">\n                        <div className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold ${s.done ? \'bg-[#38A169] text-white\' : \'bg-white border-2 border-[#E2E8F0] text-[#64748b]\'}`}>\n                          {s.done ? <CheckCircle2 size={16} /> : i + 1}\n                        </div>\n                        <span className=\"text-[11px] font-medium text-[#64748b]\">{s.step}</span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n\n              </div>\n            </div>\n          </div>\n        </div>\n      </main>\n    </div>\n  );\n};\n\n// --- 3. Pipeline Initiation View ---\nconst PipelineView = ({ onNavigate }: { onNavigate: (view: ViewState) => void }) => {\n  const [step, setStep] = useState(1);\n  \n  const handleNext = () => {\n    if (step < 3) setStep(step + 1);\n    else onNavigate(\'editor\');\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#F8FAFC] flex flex-col font-sans\">\n      <header className=\"h-16 bg-white border-b border-[#E2E8F0] flex items-center px-6\">\n        <button onClick={() => onNavigate(\'dashboard\')} className=\"text-[#64748b] hover:text-[#002045] flex items-center gap-2 font-medium text-sm\">\n           <Undo size={16} /> \353\217\214\354\225\204\352\260\200\352\270\260\n        </button>\n      </header>\n      <main className=\"flex-1 flex items-center justify-center p-6\">\n        <div className={`max-w-2xl w-full bg-white rounded-2xl border border-[#E2E8F0] p-10 ${SHADOW}`}>\n          {step === 1 && (\n            <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n              <div className=\"w-12 h-12 bg-[#f0f3ff] text-[#1a365d] rounded-xl flex items-center justify-center mb-6\">\n                <FileSearch size={24} />\n              </div>\n              <h2 className=\"text-2xl font-bold text-[#002045] mb-2\">\354\261\204\354\232\251 \352\263\265\352\263\240(JD) \354\236\205\353\240\245</h2>\n              <p className=\"text-[#64748b] mb-8\">\354\247\200\354\233\220\355\225\230\354\213\234\353\240\244\353\212\224 \354\247\201\353\254\264\354\235\230 JD\353\245\274 \353\263\265\354\202\254\355\225\230\354\227\254 \353\266\231\354\227\254\353\204\243\354\234\274\354\204\270\354\232\224. AI\352\260\200 \354\232\224\352\265\254 \354\227\255\353\237\211\354\235\204 \354\266\224\354\266\234\355\225\251\353\213\210\353\213\244.</p>\n              <textarea \n                className=\"w-full h-48 border border-[#E2E8F0] rounded-xl p-4 text-sm focus:outline-none focus:border-[#1a365d] resize-none mb-6\"\n                placeholder=\"\354\261\204\354\232\251 \352\263\265\352\263\240 \353\202\264\354\232\251...\"\n                defaultValue=\"[\354\233\271\355\210\260 PD \354\261\204\354\232\251]&#10;- \354\275\230\355\205\220\354\270\240 \352\270\260\355\232\215 \353\260\217 IP \353\260\234\352\265\264&#10;- \354\236\221\352\260\200 \354\273\244\353\256\244\353\213\210\354\274\200\354\235\264\354\205\230&#10;- \354\213\234\354\236\245 \353\260\217 \353\215\260\354\235\264\355\204\260 \353\266\204\354\204\235 \354\227\255\353\237\211 \355\225\204\354\210\230\"\n              ></textarea>\n              <div className=\"flex justify-end\">\n                <button onClick={handleNext} className=\"bg-[#002045] text-white px-6 py-3 rounded-lg font-semibold flex items-center gap-2\">\n                  JD \353\266\204\354\204\235 \353\260\217 \353\247\244\354\271\255 \354\213\234\354\236\221 <ArrowRight size={18} />\n                </button>\n              </div>\n            </motion.div>\n          )}\n          {step === 2 && (\n            <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n               <div className=\"w-12 h-12 bg-[#f0f3ff] text-[#1a365d] rounded-xl flex items-center justify-center mb-6\">\n                <Crosshair size={24} />\n              </div>\n              <h2 className=\"text-2xl font-bold text-[#002045] mb-2\">JD \303\227 Candidate \353\247\244\354\271\255 \352\262\260\352\263\274</h2>\n              <p className=\"text-[#64748b] mb-8\">\353\202\264 Vault\354\227\220 \354\240\200\354\236\245\353\220\234 \352\262\275\355\227\230\352\263\274 \354\261\204\354\232\251 \352\263\265\352\263\240\354\235\230 \354\232\224\352\265\254 \354\227\255\353\237\211\354\235\204 \353\247\244\354\271\255\355\226\210\354\212\265\353\213\210\353\213\244.</p>\n              \n              <div className=\"space-y-4 mb-8\">\n                <div className=\"p-4 border border-[#38A169] bg-[#38A169]/5 rounded-xl flex justify-between items-center\">\n                  <div>\n                    <div className=\"flex items-center gap-2 mb-1\">\n                      <span className=\"text-sm font-bold text-[#38A169]\">\355\225\204\354\202\264\352\270\260 \353\247\244\354\271\255</span>\n                      <span className=\"text-xs text-[#002045] font-semibold bg-white px-2 py-0.5 rounded border border-[#E2E8F0]\">\354\275\230\355\205\220\354\270\240 \352\270\260\355\232\215</span>\n                    </div>\n                    <p className=\"text-[#002045] font-medium\">\355\224\204\353\241\234\354\240\235\355\212\270 A (\354\204\234\353\271\204\354\212\244 \352\265\254\354\241\260 \354\204\244\352\263\204 \352\262\275\355\227\230)</p>\n                  </div>\n                  <span className=\"text-2xl font-bold text-[#38A169]\">88%</span>\n                </div>\n                <div className=\"p-4 border border-[#E2E8F0] rounded-xl flex justify-between items-center\">\n                  <div>\n                    <div className=\"flex items-center gap-2 mb-1\">\n                      <span className=\"text-sm font-bold text-[#64748b]\">\353\271\214\354\202\264\352\270\260 \353\247\244\354\271\255</span>\n                      <span className=\"text-xs text-[#002045] font-semibold bg-slate-100 px-2 py-0.5 rounded border border-[#E2E8F0]\">\353\215\260\354\235\264\355\204\260 \355\231\234\354\232\251</span>\n                    </div>\n                    <p className=\"text-[#002045] font-medium\">\355\224\204\353\241\234\354\240\235\355\212\270 B (\353\215\260\354\235\264\355\204\260 \353\266\204\354\204\235 \354\204\261\352\263\274)</p>\n                  </div>\n                  <span className=\"text-2xl font-bold text-[#64748b]\">81%</span>\n                </div>\n                <div className=\"p-4 border border-[#E2E8F0] bg-slate-50 rounded-xl flex justify-between items-center\">\n                   <div>\n                    <div className=\"flex items-center gap-2 mb-1\">\n                      <span className=\"text-sm font-bold text-[#64748b]\">\352\267\274\352\261\260 \353\266\200\354\241\261 (Warning)</span>\n                      <span className=\"text-xs text-[#002045] font-semibold bg-white px-2 py-0.5 rounded border border-[#E2E8F0]\">IP \353\260\234\352\265\264</span>\n                    </div>\n                    <p className=\"text-sm text-[#64748b] mt-1\">\355\230\204\354\236\254 Vault \354\236\220\353\243\214\354\227\220\354\204\234\353\212\224 IP \353\260\234\352\265\264\354\235\204 \354\247\201\354\240\221 \354\246\235\353\252\205\355\225\240 \352\267\274\352\261\260\352\260\200 \353\266\200\354\241\261\355\225\251\353\213\210\353\213\244.</p>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"flex justify-between items-center\">\n                <button onClick={() => setStep(1)} className=\"text-[#64748b] font-medium\">\354\235\264\354\240\204</button>\n                <button onClick={handleNext} className=\"bg-[#002045] text-white px-6 py-3 rounded-lg font-semibold flex items-center gap-2\">\n                  \353\254\270\354\204\234 \354\236\254\352\265\254\354\204\261 \353\213\250\352\263\204\353\241\234 \354\235\264\353\217\231 <ArrowRight size={18} />\n                </button>\n              </div>\n            </motion.div>\n          )}\n          {step === 3 && (\n            <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className=\"text-center py-10\">\n              <Loader2 className=\"w-12 h-12 text-[#1a365d] animate-spin mx-auto mb-6\" />\n              <h2 className=\"text-2xl font-bold text-[#002045] mb-2\">\354\247\200\354\233\220 \354\240\204\353\236\265\354\235\204 \353\260\230\354\230\201\355\225\230\354\227\254 \353\254\270\354\204\234\353\245\274 \354\203\235\354\204\261\354\244\221\354\236\205\353\213\210\353\213\244</h2>\n              <p className=\"text-[#64748b]\">Evidence Validator\352\260\200 \354\210\253\354\236\220\354\231\200 \352\267\274\352\261\260\353\245\274 \355\231\225\354\235\270\355\225\230\352\263\240 \354\236\210\354\212\265\353\213\210\353\213\244...</p>\n              {/* Auto advance simulated by useEffect in real app, here we just show a button for flow */}\n              <button onClick={handleNext} className=\"mt-8 text-sm text-[#64748b] underline\">\354\231\204\353\243\214 \354\213\234\353\254\274\353\240\210\354\235\264\354\205\230 (\354\227\220\353\224\224\355\204\260\353\241\234 \354\235\264\353\217\231)</button>\n            </motion.div>\n          )}\n        </div>\n      </main>\n    </div>\n  )\n}\n\n\n// --- 4. Copilot Editor View (Writing + Defense) ---\nconst EditorView = ({ onNavigate }: { onNavigate: (view: ViewState) => void }) => {\n  const [activeTab, setActiveTab] = useState<\'strategy\' | \'evidence\' | \'defense\'>(\'defense\');\n\n  return (\n    <div className=\"h-screen bg-[#F8FAFC] flex flex-col font-sans overflow-hidden\">\n      <header className=\"h-16 flex-none bg-white border-b border-[#E2E8F0] flex justify-between items-center px-6 z-10\">\n        <div className=\"flex items-center gap-6\">\n          <button onClick={() => onNavigate(\'dashboard\')} className=\"font-bold text-xl text-[#002045] tracking-tight hover:opacity-80\">CareerCraft</button>\n          <span className=\"text-[#38A169] text-sm font-bold px-3 py-1 bg-[#38A169]/10 rounded-full flex items-center gap-2\">\n            <ShieldCheck size={16}/> Evidence-based\n          </span>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <span className=\"text-xs text-[#64748b] hidden sm:block\">Defensible Score: 87/100</span>\n          <button className=\"px-4 py-2 border border-[#E2E8F0] rounded-lg text-[#002045] text-sm font-semibold hover:bg-slate-50\">PDF \353\202\264\353\263\264\353\202\264\352\270\260</button>\n          <button className=\"px-4 py-2 bg-[#002045] text-white rounded-lg text-sm font-semibold hover:bg-opacity-90 shadow-sm\">\354\265\234\354\242\205 \354\240\200\354\236\245</button>\n        </div>\n      </header>\n\n      <div className=\"flex-1 flex overflow-hidden p-6 gap-6 max-w-screen-2xl mx-auto w-full\">\n        {/* Left: Document Editor with Annotations */}\n        <div className={`flex-[3] bg-white rounded-2xl border border-[#E2E8F0] ${SHADOW} flex flex-col relative overflow-hidden`}>\n          <div className=\"border-b border-[#E2E8F0] p-4 flex gap-2 bg-slate-50\">\n             <button className=\"p-2 hover:bg-white rounded-lg text-[#64748b] shadow-sm bg-white border border-[#E2E8F0]\"><Undo size={16}/></button>\n             <button className=\"p-2 hover:bg-white rounded-lg text-[#64748b]\"><Redo size={16}/></button>\n          </div>\n\n          <div className=\"flex-1 overflow-y-auto p-12 md:p-16\">\n            <div className=\"max-w-[700px] mx-auto text-[#002045] text-lg leading-loose space-y-6\">\n              <h2 className=\"text-2xl font-bold border-b border-[#E2E8F0] pb-2 mb-6\">1. \354\247\200\354\233\220 \354\247\201\353\254\264\354\231\200 \352\264\200\353\240\250\353\220\234 \355\225\265\354\213\254 \355\224\204\353\241\234\354\240\235\355\212\270 \352\262\275\355\227\230</h2>\n              \n              <p>\n                \353\215\260\354\235\264\355\204\260 \352\270\260\353\260\230\354\235\230 \354\235\230\354\202\254\352\262\260\354\240\225\354\234\274\353\241\234 \354\204\234\353\271\204\354\212\244\354\235\230 \354\202\254\354\232\251\354\204\261\354\235\204 \352\267\271\353\214\200\355\231\224\355\225\234 \352\262\275\355\227\230\354\235\264 \354\236\210\354\212\265\353\213\210\353\213\244. TechFlow Solutions \354\236\254\354\247\201 \353\213\271\354\213\234, \n                <span className=\"bg-[#38A169]/20 border-b-2 border-[#38A169] relative group cursor-pointer px-1 rounded mx-1\">\n                  \352\270\260\354\241\264 7\354\235\274\354\235\264 \352\261\270\353\246\254\353\215\230 \354\204\234\353\245\230 \354\240\220\352\262\200 \354\227\205\353\254\264\353\245\274 2\354\235\274 \353\202\264 \354\262\230\353\246\254\355\225\240 \354\210\230 \354\236\210\353\217\204\353\241\235 \352\260\234\354\204\240\355\226\210\354\212\265\353\213\210\353\213\244.\n                  <CheckCircle2 size={14} className=\"inline ml-1 text-[#38A169]\"/>\n                </span>\n                \353\260\230\353\263\265\353\220\230\353\212\224 \353\254\270\354\235\230 \355\225\255\353\252\251\354\235\204 \353\266\204\354\204\235\355\225\230\354\227\254 \354\262\264\355\201\254\353\246\254\354\212\244\355\212\270\353\245\274 \354\236\220\353\217\231\355\231\224\355\225\234 \352\262\260\352\263\274\354\236\205\353\213\210\353\213\244.\n              </p>\n\n              <p>\n                \353\230\220\355\225\234, \354\213\240\352\267\234 \352\270\260\353\212\245 \353\237\260\354\271\255 \352\263\274\354\240\225\354\227\220\354\204\234 \355\214\200 \352\260\204\354\235\230 \354\206\214\355\206\265 \354\230\244\353\245\230\353\245\274 \354\244\204\354\235\264\352\270\260 \354\234\204\355\225\264 \354\225\240\354\236\220\354\235\274 \353\260\251\353\262\225\353\241\240\354\235\204 \353\217\204\354\236\205\355\225\230\354\230\200\352\263\240, \n                \352\267\270 \352\262\260\352\263\274 \n                <span className=\"bg-amber-100 border-b-2 border-amber-500 relative group cursor-pointer px-1 rounded mx-1\">\n                  \355\214\200\354\235\230 \354\227\205\353\254\264 \355\232\250\354\234\250\354\235\204 40% \354\235\264\354\203\201 \355\201\254\352\262\214 \355\226\245\354\203\201\354\213\234\354\274\260\354\212\265\353\213\210\353\213\244.\n                  <AlertTriangle size={14} className=\"inline ml-1 text-amber-600\"/>\n                </span>\n                \354\235\264\353\212\224 \354\204\261\352\263\265\354\240\201\354\235\270 \355\224\204\353\241\234\354\240\235\355\212\270 \353\237\260\354\271\255\354\235\230 \355\225\265\354\213\254 \354\233\220\353\217\231\353\240\245\354\235\264 \353\220\230\354\227\210\354\212\265\353\213\210\353\213\244.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* Right: AI Copilot Sidebar */}\n        <div className={`w-[400px] flex-none bg-white rounded-2xl border border-[#E2E8F0] ${SHADOW} flex flex-col overflow-hidden`}>\n          <div className=\"flex border-b border-[#E2E8F0] bg-slate-50 p-2 gap-2\">\n            <button \n              onClick={() => setActiveTab(\'strategy\')}\n              className={`flex-1 py-2 text-center text-sm font-bold rounded-lg transition-colors ${activeTab === \'strategy\' ? \'bg-white text-[#1a365d] shadow-sm border border-[#E2E8F0]\' : \'text-[#64748b] hover:bg-white/50\'}`}\n            >\354\247\200\354\233\220 \354\240\204\353\236\265</button>\n            <button \n              onClick={() => setActiveTab(\'evidence\')}\n              className={`flex-1 py-2 text-center text-sm font-bold rounded-lg transition-colors ${activeTab === \'evidence\' ? \'bg-white text-[#1a365d] shadow-sm border border-[#E2E8F0]\' : \'text-[#64748b] hover:bg-white/50\'}`}\n            >\354\210\253\354\236\220 \352\262\200\354\246\235</button>\n            <button \n              onClick={() => setActiveTab(\'defense\')}\n              className={`flex-1 py-2 text-center text-sm font-bold rounded-lg transition-colors ${activeTab === \'defense\' ? \'bg-[#1a365d] text-white shadow-sm\' : \'text-[#64748b] hover:bg-white/50\'}`}\n            >\353\251\264\354\240\221 \353\260\251\354\226\264</button>\n          </div>\n\n          <div className=\"flex-1 overflow-y-auto p-5 bg-slate-50 space-y-5\">\n             {activeTab === \'evidence\' && (\n               <>\n                <div className=\"bg-white p-4 rounded-xl border border-[#E2E8F0] shadow-sm\">\n                  <div className=\"flex gap-2 items-start mb-3\">\n                    <CheckCircle2 size={18} className=\"text-[#38A169] flex-shrink-0 mt-0.5\"/>\n                    <div>\n                      <h4 className=\"font-bold text-sm text-[#002045]\">\352\262\200\354\246\235 \354\231\204\353\243\214: \354\236\205\353\240\245 \354\210\230\354\271\230 \354\235\274\354\271\230</h4>\n                      <p className=\"text-xs text-[#64748b] mt-1\">\354\202\254\354\232\251\354\236\220\352\260\200 \354\240\234\352\263\265\355\225\234 Vault \352\262\275\355\227\230 \353\215\260\354\235\264\355\204\260(2023.08 TechFlow)\354\231\200 \354\240\225\355\231\225\355\236\210 \354\235\274\354\271\230\355\225\251\353\213\210\353\213\244.</p>\n                    </div>\n                  </div>\n                  <div className=\"bg-slate-50 p-3 rounded-lg text-sm border-l-2 border-[#38A169] text-[#002045]\">\n                    \"\352\270\260\354\241\264 7\354\235\274\354\235\264 \352\261\270\353\246\254\353\215\230 \354\204\234\353\245\230 \354\240\220\352\262\200 \354\227\205\353\254\264\353\245\274 2\354\235\274 \353\202\264 \354\262\230\353\246\254\355\225\240 \354\210\230 \354\236\210\353\217\204\353\241\235...\"\n                  </div>\n                </div>\n\n                <div className=\"bg-white p-4 rounded-xl border border-amber-300 shadow-sm relative overflow-hidden\">\n                  <div className=\"absolute top-0 left-0 w-1 h-full bg-amber-500\"></div>\n                  <div className=\"flex gap-2 items-start mb-3\">\n                    <AlertTriangle size={18} className=\"text-amber-600 flex-shrink-0 mt-0.5\"/>\n                    <div>\n                      <h4 className=\"font-bold text-sm text-[#002045]\">\354\243\274\354\235\230: \354\233\220\353\263\270 \352\267\274\352\261\260 \354\227\206\354\235\214 (UNVERIFIED)</h4>\n                      <p className=\"text-xs text-[#64748b] mt-1\">Vault \354\236\220\353\243\214\354\227\220\354\204\234 \'40% \355\232\250\354\234\250 \355\226\245\354\203\201\'\354\227\220 \353\214\200\355\225\234 \354\247\201\354\240\221\354\240\201\354\235\270 \354\270\241\354\240\225 \352\267\274\352\261\260\353\245\274 \354\260\276\354\235\204 \354\210\230 \354\227\206\354\212\265\353\213\210\353\213\244.</p>\n                    </div>\n                  </div>\n                  <div className=\"bg-amber-50 p-3 rounded-lg text-sm border-l-2 border-amber-300 mb-3 text-amber-900 line-through opacity-70\">\n                    \"...\354\227\205\353\254\264 \355\232\250\354\234\250\354\235\204 40% \354\235\264\354\203\201 \355\201\254\352\262\214 \355\226\245\354\203\201\354\213\234\354\274\260\354\212\265\353\213\210\353\213\244.\"\n                  </div>\n                  <p className=\"text-xs font-bold text-[#1a365d] mb-2\">AI \354\210\230\354\240\225 \354\240\234\354\225\210 (\354\266\224\354\203\201\355\231\224 \353\260\217 \355\226\211\353\217\231 \354\244\221\354\213\254):</p>\n                  <div className=\"bg-[#f0f3ff] p-3 rounded-lg text-sm border border-[#1a365d]/20 text-[#002045] mb-3\">\n                    \"...\355\214\200 \352\260\204\354\235\230 \354\235\230\354\202\254\354\206\214\355\206\265 \354\247\200\354\227\260\354\235\204 \353\260\251\354\247\200\355\225\230\352\263\240 \354\230\210\354\240\225\353\220\234 \354\235\274\354\240\225 \353\202\264\354\227\220 \354\213\240\352\267\234 \352\270\260\353\212\245\354\235\204 \354\204\261\352\263\265\354\240\201\354\234\274\353\241\234 \353\237\260\354\271\255\355\226\210\354\212\265\353\213\210\353\213\244.\"\n                  </div>\n                  <button className=\"w-full py-2 bg-[#1a365d] text-white rounded-lg text-sm font-bold\">\354\210\230\354\240\225\354\225\210 \354\240\201\354\232\251</button>\n                </div>\n               </>\n             )}\n\n             {activeTab === \'defense\' && (\n               <>\n                 <div className=\"bg-[#1a365d] text-white p-4 rounded-xl shadow-sm mb-4\">\n                    <h3 className=\"font-bold mb-1 flex items-center gap-2\"><ShieldAlert size={18} /> \353\252\250\354\235\230 \354\225\225\353\260\225 \353\251\264\354\240\221</h3>\n                    <p className=\"text-xs opacity-80\">\355\230\204\354\236\254 \354\236\221\354\204\261\353\220\234 \354\236\220\354\206\214\354\204\234\353\245\274 \352\270\260\353\260\230\354\234\274\353\241\234 \353\260\251\354\226\264\355\225\230\352\270\260 \354\226\264\353\240\244\354\232\264 \354\247\200\354\240\220\354\235\204 \352\263\265\352\262\251\355\225\251\353\213\210\353\213\244.</p>\n                 </div>\n\n                 {/* Chat Bubble AI */}\n                 <div className=\"flex gap-3\">\n                    <div className=\"w-8 h-8 rounded-full bg-slate-200 flex-shrink-0 flex items-center justify-center text-[#1a365d]\">\n                      <User size={16} />\n                    </div>\n                    <div className=\"bg-white border border-[#E2E8F0] p-3 rounded-2xl rounded-tl-sm text-sm text-[#002045] shadow-sm\">\n                      \354\247\200\354\233\220\354\236\220\353\213\230, \"\354\204\234\353\245\230 \354\240\220\352\262\200 \354\227\205\353\254\264\353\245\274 7\354\235\274\354\227\220\354\204\234 2\354\235\274\353\241\234 \353\213\250\354\266\225\355\226\210\353\213\244\"\352\263\240 \355\225\230\354\205\250\353\212\224\353\215\260, \352\265\254\354\262\264\354\240\201\354\234\274\353\241\234 \354\226\264\353\226\244 \354\262\264\355\201\254\353\246\254\354\212\244\355\212\270\353\245\274 \354\236\220\353\217\231\355\231\224\355\225\230\354\205\250\353\212\224\354\247\200, \352\267\270\353\246\254\352\263\240 \352\267\270 \352\263\274\354\240\225\354\227\220\354\204\234 \353\263\270\354\235\270\354\235\230 \355\225\265\354\213\254 \354\227\255\355\225\240\354\235\200 \353\254\264\354\227\207\354\235\264\354\227\210\353\212\224\354\247\200 \354\204\244\353\252\205\355\225\264\354\243\274\354\213\234\352\262\240\354\226\264\354\232\224?\n                    </div>\n                 </div>\n\n                 {/* Chat Bubble User Prompt */}\n                 <div className=\"flex gap-3 flex-row-reverse mt-2\">\n                    <div className=\"w-8 h-8 rounded-full bg-[#1a365d] flex-shrink-0 flex items-center justify-center text-white\">\n                      <Bot size={16} />\n                    </div>\n                    <div className=\"bg-[#f0f3ff] border border-[#1a365d]/20 p-3 rounded-2xl rounded-tr-sm text-sm text-[#002045] shadow-sm\">\n                      <span className=\"text-[#64748b] italic\">\354\235\264 \354\247\210\353\254\270\354\227\220 \353\213\265\355\225\240 \354\210\230 \354\227\206\353\213\244\353\251\264, \354\236\220\354\206\214\354\204\234\354\235\230 \352\265\254\354\262\264\354\204\261\354\235\204 \353\202\256\354\266\224\352\261\260\353\202\230 \353\263\270\354\235\270\354\235\230 \354\227\255\355\225\240(My Role)\354\235\204 \353\252\205\355\231\225\355\236\210 \355\225\230\353\212\224 \353\254\270\354\236\245\354\235\204 \354\266\224\352\260\200\355\225\264\354\225\274 \355\225\251\353\213\210\353\213\244.</span>\n                    </div>\n                 </div>\n               </>\n             )}\n\n             {activeTab === \'strategy\' && (\n               <div className=\"bg-white p-4 rounded-xl border border-[#E2E8F0] shadow-sm\">\n                 <h4 className=\"font-bold text-[#002045] mb-4\">\355\230\204\354\236\254 \355\217\254\354\247\200\354\205\230: \354\275\230\355\205\220\354\270\240 \352\270\260\355\232\215</h4>\n                 <div className=\"space-y-4\">\n                   <div>\n                     <span className=\"text-xs font-bold text-[#38A169] bg-[#38A169]/10 px-2 py-1 rounded\">\355\225\204\354\202\264\352\270\260</span>\n                     <p className=\"text-sm text-[#002045] mt-2 font-medium\">\355\224\204\353\241\234\354\240\235\355\212\270 A (\354\204\234\353\271\204\354\212\244 \352\270\260\355\232\215)</p>\n                     <p className=\"text-xs text-[#64748b] mt-1\">\354\235\264\353\240\245\354\204\234\354\231\200 \354\236\220\354\206\214\354\204\234 \354\240\204\353\260\230\354\227\220 \352\260\200\354\236\245 \354\232\260\354\204\240 \353\260\260\354\271\230\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244.</p>\n                   </div>\n                   <div className=\"h-px bg-[#E2E8F0]\"></div>\n                   <div>\n                     <span className=\"text-xs font-bold text-[#64748b] bg-slate-100 px-2 py-1 rounded\">\355\217\254\355\212\270\355\217\264\353\246\254\354\230\244 \354\266\224\354\262\234</span>\n                     <p className=\"text-sm text-[#002045] mt-2 font-medium\">\353\215\260\354\235\264\355\204\260 \353\266\204\354\204\235 \353\246\254\355\217\254\355\212\270 (\355\224\204\353\241\234\354\240\235\355\212\270 B)</p>\n                     <p className=\"text-xs text-[#64748b] mt-1\">JD\354\227\220 \'\353\215\260\354\235\264\355\204\260 \355\231\234\354\232\251 \354\227\255\353\237\211\'\354\235\264 \353\252\205\354\213\234\353\220\230\354\226\264 \354\236\210\354\234\274\353\257\200\353\241\234 \355\217\254\355\212\270\355\217\264\353\246\254\354\230\244 2\353\262\210\354\247\270 \354\236\245\354\227\220 \354\266\224\352\260\200\353\245\274 \352\266\214\354\236\245\355\225\251\353\213\210\353\213\244.</p>\n                   </div>\n                 </div>\n               </div>\n             )}\n          </div>\n\n          {activeTab === \'defense\' && (\n            <div className=\"p-3 bg-white border-t border-[#E2E8F0]\">\n              <div className=\"relative\">\n                <input type=\"text\" placeholder=\"\353\251\264\354\240\221\352\264\200\354\235\230 \354\247\210\353\254\270\354\227\220 \353\213\265\353\263\200 \355\205\214\354\212\244\355\212\270\355\225\264\353\263\264\352\270\260...\" className=\"w-full bg-slate-50 border border-[#E2E8F0] rounded-xl pl-4 pr-10 py-3 text-sm focus:outline-none focus:border-[#1a365d]\" />\n                <button className=\"absolute right-3 top-1/2 -translate-y-1/2 text-[#1a365d]\">\n                  <Send size={18}/>\n                </button>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n\n// --- Main App Component ---\nexport default function App() {\n  const [currentView, setCurrentView] = useState<ViewState>(\'landing\');\n  const [isLoading, setIsLoading] = useState(false);\n  const [loadingMsg, setLoadingMsg] = useState(\'\353\266\210\353\237\254\354\230\244\353\212\224 \354\244\221...\');\n\n  const handleNavigate = (view: ViewState) => {\n    if (view === currentView) return;\n    \n    if (view === \'pipeline\') setLoadingMsg(\'Candidate Vault\353\245\274 \353\266\210\353\237\254\354\230\244\353\212\224 \354\244\221...\');\n    else if (view === \'editor\') setLoadingMsg(\'Evidence Validator \354\213\244\355\226\211 \354\244\221...\');\n    else setLoadingMsg(\'\353\266\210\353\237\254\354\230\244\353\212\224 \354\244\221...\');\n\n    setIsLoading(true);\n    setTimeout(() => {\n      setCurrentView(view);\n      setIsLoading(false);\n    }, 800);\n  };\n\n  return (\n    <>\n      <AnimatePresence>\n        {isLoading && <LoadingOverlay message={loadingMsg} />}\n      </AnimatePresence>\n\n      {currentView === \'landing\' && <LandingView onNavigate={handleNavigate} />}\n      {currentView === \'dashboard\' && <DashboardView onNavigate={handleNavigate} />}\n      {currentView === \'pipeline\' && <PipelineView onNavigate={handleNavigate} />}\n      {currentView === \'editor\' && <EditorView onNavigate={handleNavigate} />}\n    </>\n  );\n}\n"
    }
