      text: "\354\242\213\354\225\204. \354\247\200\352\270\210\352\271\214\354\247\200 \353\202\230\354\230\250 \353\202\264\354\232\251\354\235\204 \352\270\260\354\244\200\354\234\274\353\241\234 **\354\204\234\353\271\204\354\212\244\354\235\230 \354\262\240\355\225\231 \342\206\222 \353\254\270\354\204\234\353\263\204 \354\227\255\355\225\240 \342\206\222 \354\202\254\354\232\251\354\236\220 \355\235\220\353\246\204 \342\206\222 AI \353\266\204\354\204\235/\354\266\224\354\262\234 \342\206\222 \354\236\221\354\204\261/\354\262\250\354\202\255 \342\206\222 \352\262\200\354\246\235 \342\206\222 \352\270\260\354\210\240 \354\225\204\355\202\244\355\205\215\354\262\230 \342\206\222 MVP \353\262\224\354\234\204**\352\271\214\354\247\200 \355\225\230\353\202\230\353\241\234 \355\225\251\354\271\234 \354\265\234\354\242\205 PRD\353\241\234 \354\240\225\353\246\254\355\225\234\353\213\244.\n\n# AI \354\267\250\354\227\205 \354\275\224\355\214\214\354\235\274\353\237\277 \354\265\234\354\242\205 PRD v1.0\n\n## 1. Product Overview\n\n### \354\204\234\353\271\204\354\212\244 \355\225\234 \354\244\204\n\n> **\353\202\264 \352\262\275\355\227\230\354\235\204 \354\247\201\353\254\264\354\227\220 \353\247\236\353\212\224 \352\260\225\355\225\234 \352\267\274\352\261\260\353\241\234 \353\260\224\352\276\270\352\263\240, \354\235\264\353\240\245\354\204\234\302\267\352\262\275\353\240\245\352\270\260\354\210\240\354\204\234\302\267\354\236\220\354\206\214\354\204\234\302\267\355\217\254\355\212\270\355\217\264\353\246\254\354\230\244\353\245\274 \352\260\201\352\260\201\354\235\230 \353\252\251\354\240\201\354\227\220 \353\247\236\352\262\214 \354\231\204\354\204\261\355\225\230\353\217\204\353\241\235 \353\217\225\353\212\224 AI \354\267\250\354\227\205 \354\275\224\355\214\214\354\235\274\353\237\277**\n\n### \355\225\265\354\213\254 \354\262\240\355\225\231\n\n> **AI\352\260\200 \354\227\206\353\212\224 \352\262\275\355\227\230\354\235\204 \353\247\214\353\223\244\354\226\26