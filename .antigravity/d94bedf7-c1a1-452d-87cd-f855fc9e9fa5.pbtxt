        lines {
          text: "                \353\260\230\353\263\265\353\220\230\353\212\224 \353\254\270\354\235\230 \355\225\255\353\252\251\354\235\204 \353\266\204\354\204\235\355\225\230\354\227\254 \354\262\264\355\201\254\353\246\254\354\212\244\355\212\270\353\245\274 \354\236\220\353\217\231\355\231\224\355\225\234 \352\262\260\352\263\274\354\236\205\353\213\210\353\213\244."
