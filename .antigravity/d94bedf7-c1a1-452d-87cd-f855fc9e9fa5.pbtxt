\n             \354\203\210 \354\236\221\354\204\261       \352\270\260\354\241\264 \354\210\230\354\240\225     \355\217\254\355\217\264 \354\266\224\354\262\234\n                \342\224\202            \342\224\202            \342\224\202\n                \342\224\224\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\274\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\230\n                             \342\226\274\n                      Mistral 128B\n                         GENERATE\n                             \342\224\202\n                             \342\226\274\n                      Nemotron 120B\n                     CRITIC / VERIFY\n                             \342\224\202\n                 \342\224\214\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\264\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\220\n                 \342\226\274                       \342\226\274\n            Evidence Check          Defense Test\n                 \342\224\202                       \342\224\202\n                 \342\224\224\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\254\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\230\n                             \342\226\274\n                       FINAL APPLICATION\n                             \342\224\202\n                             \342\226\274\n                 \354\236\220\354\206\214\354\204\234 + \355\217\254\355\217\264 \354\240\204\353\236\265 + \353\251\264\354\240\221\n```\n\n**\354\235\264\352\261\270 \354\265\234\354\242\205 PRD\354\235\230 \352\270\260\354\244\200 \354\225\204\355\202\244\355\205\215\354\262\230\353\241\234 \354\202\274\353\212\224 \352\262\214 \354\242\213\353\213\244.**\n\n\355\212\271\355\236\210 \354\247\200\352\270\210 \353\213\250\352\263\204\354\227\220\354\204\234\353\212\224 **RAG, Vector DB, Multi-Agent\353\245\274 \353\250\274\354\240\200 \352\265\254\355\230\204\355\225\230\354\247\200 \354\225\212\353\212\224 \352\262\203**\354\235\204 \352\266\214\355\225\234\353\213\244. \354\202\254\354\232\251\354\236\220\354\235\230 \354\236\220\354\206\214\354\204\234/\355\217\254\355\217\264/\352\262\275\355\227\230 \353\215\260\354\235\264\355\204\260\352\260\200 \354\225\204\354\243\274 \353\247\216\354\247\200 \354\225\212\354\235\200 MVP\354\227\220\354\204\234\353\212\224 PostgreSQL\354\227\220 \352\265\254\354\241\260\355\231\224\353\220\234 Experience + Evidence\353\245\274 \354\240\200\354\236\245\355\225\230\352\263\240, \355\225\204\354\232\224\355\225\234 \353\254\270\353\247\245\353\247\214 LLM\354\227\220 \353\204\230\352\270\260\353\212\224 \352\262\214 \355\233\250\354\224\254 \353\213\250\354\210\234\355\225\230\352\263\240 \354\240\225\355\231\225\355\225\230\353\213\244. \354\236\220\353\243\214\352\260\200 \354\266\225\354\240\201\353\220\230\354\226\264 **\355\225\234 \354\247\200\354\233\220\354\236\220\352\260\200 \354\210\230\354\213\255~\354\210\230\353\260\261 \352\260\234\354\235\230 \352\262\275\355\227\230/\353\254\270\354\204\234\353\245\274 \352\260\226\352\262\214 \353\220\230\353\212\224 \354\213\234\354\240\220**\354\227\220 RAG/Reranker\353\245\274 \354\266\224\352\260\200\355\225\230\353\251\264 \353\220\234\353\213\244.\n\n\352\267\270\353\246\254\352\263\240 \354\235\264 PRD\354\227\220\354\204\234 \352\260\200\354\236\245 \353\250\274\354\240\200 \352\265\254\355\230\204\355\225\264\354\225\274 \355\225\240 \352\262\203\354\235\200 **\342\221\2