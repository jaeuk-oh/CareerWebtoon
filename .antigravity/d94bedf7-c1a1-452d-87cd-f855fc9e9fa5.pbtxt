    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport {\n  Bot,\n  LayoutDashboard,\n  TrendingUp,\n  Kanban,\n  ArrowRight,\n  Briefcase,\n  Plus,\n  Folder,\n  Settings,\n  FileText,\n  MonitorSmartphone,\n  Sparkles,\n  Palette,\n  Bold,\n  Italic,\n  Underline,\n  List,\n  ListOrdered,\n  Undo,\n  Redo,\n  Lightbulb,\n  CheckCircle2,\n  Send,\n  Type,\n  Image as ImageIcon,\n  LayoutGrid,\n  Award,\n  Mail,\n  Edit2,\n  Trash2,\n  Menu,\n  User,\n  Loader2\n} from \'lucide-react\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\n// --- Shared Styles & Constants ---\nconst COLORS = {\n  primary: \'#002045\',\n  primaryContainer: \'#1a365d\',\n  success: \'#38A169\',\n  background: \'#F8FAFC\',\n  surface: \'#FFFFFF\',\n  border: \'#E2E8F0\',\n  textSecondary: \'#64748b\',\n};\n\nconst SHADOW = \'shadow-[0_4px_6px_-1px_rgba(26,54,93,0.05),0_2px_4px_-1px_rgba(26,54,93,0.03)]\';\nconst HOVER_SHADOW = \'hover:shadow-[0_10px_15px_-3px_rgba(26,54,93,0.1),0_4px_6px_-2px_rgba(26,54,93,0.05)]\';\n\ntype ViewState = \'landing\' | \'dashboard\' | \'resume\' | \'portfolio\';\n\n// --- Loading Component ---\nconst LoadingOverlay = () => (\n  <motion.div\n    initial={{ opacity: 0 }}\n    animate={{ opacity: 1 }}\n    exit={{ opacity: 0 }}\n    className=\"fixed inset-0 bg-white/80 backdrop-blur-sm z-50 flex flex-col items-center justify-center\"\n  >\n    <Loader2 className=\"w-12 h-12 text-[#002045] animate-spin mb-4\" />\n    <p className=\"text-[#002045] font-medium animate-pulse\">\354\233\214\355\201\254\354\212\244\355\216\230\354\235\264\354\212\244\353\245\274 \353\266\210\353\237\254\354\230\244\353\212\224 \354\244\221\354\236\205\353\213\210\353\213\244...</p>\n  </motion.div>\n);\n\n// --- 1. Landing View ---\nconst LandingView = ({ onNavigate }: { onNavigate: (view: ViewState) => void }) => {\n  return (\n    <div className=\"min-h-screen bg-[#F8FAFC] flex flex-col font-sans\">\n      <header className=\"w-full h-16 bg-white border-b border-[#E2E8F0] sticky top-0 z-40\">\n        <div className=\"max-w-7xl mx-auto px-6 h-full flex justify-between items-center\">\n          <div className=\"text-2xl font-bold text-[#002045] tracking-tight\">CareerCraft</div>\n          <nav className=\"hidden md:flex gap-8 items-center\">\n            <button onClick={() => onNavigate(\'dashboard\')} className=\"text-[#64748b] hover:text-[#002045] transition-colors font-medium\">\353\214\200\354\213\234\353\263\264\353\223\234</button>\n            <button onClick={() => onNavigate(\'resume\')} className=\"text-[#64748b] hover:text-[#002045] transition-colors font-medium\">\354\236\220\352\270\260\354\206\214\352\260\234\354\204\234</button>\n            <button onClick={() => onNavigate(\'portfolio\')} className=\"text-[#64748b] hover:text-[#002045] transition-colors font-medium\">\355\217\254\355\212\270\355\217\264\353\246\254\354\230\244</button>\n            <button className=\"text-[#64748b] hover:text-[#002045] transition-colors font-medium\">\354\273\244\353\256\244\353\213\210\355\213\260</button>\n          </nav>\n          <button className=\"text-[#002045] font-semibold hover:text-[#38A169] transition-colors\">\355\224\204\353\241\234\355\225\204</button>\n        </div>\n      </header>\n\n      <main className=\"flex-grow\">\n        {/* Hero */}\n        <section className=\"py-24 px-6 max-w-4xl mx-auto text-center flex flex-col items-center\">\n          <motion.h1 \n            initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }}\n            className=\"text-5xl md:text-6xl font-bold text-[#002045] mb-6 tracking-tight leading-tight\"\n          >\n            \354\204\261\352\263\265\354\240\201\354\235\270 \354\273\244\353\246\254\354\226\264\353\245\274 \354\234\204\355\225\234<br/>\354\231\204\353\262\275\355\225\234 \354\204\244\352\263\204.\n          </motion.h1>\n          <motion.p \n            initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}\n            className=\"text-xl text-[#64748b] max-w-2xl mb-10 leading-relaxed\"\n          >\n            \355\230\204\353\214\200\354\240\201\354\235\270 \354\204\261\354\267\250\354\236\220\353\245\274 \354\234\204\355\225\264 \354\204\244\352\263\204\353\220\234 \354\247\200\353\212\245\355\230\225 \353\217\204\352\265\254 \353\252\250\354\235\214\354\234\274\353\241\234 \354\240\204\353\254\270\354\240\201\354\235\270 \352\262\275\353\240\245\354\235\204 \355\225\234 \353\213\250\352\263\204 \353\206\222\354\235\264\354\204\270\354\232\224. \352\265\254\354\266\225\355\225\230\352\263\240, \354\266\224\354\240\201\355\225\230\353\251\260, \354\204\261\352\263\265\354\235\204 \352\261\260\353\221\220\354\204\270\354\232\224.\n          </motion.p>\n          <motion.div \n            initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.2 }}\n            className=\"flex gap-4 flex-col sm:flex-row\"\n          >\n            <button onClick={() => onNavigate(\'dashboard\')} className=\"bg-[#38A169] text-white px-8 py-3 rounded-md font-semibold hover:bg-opacity-90 transition-all shadow-sm\">\n              \353\254\264\353\243\214\353\241\234 \354\213\234\354\236\221\355\225\230\352\270\260\n            </button>\n            <button className=\"bg-transparent text-[#002045] border border-[#E2E8F0] px-8 py-3 rounded-md font-semibold hover:bg-slate-50 transition-all\">\n              \352\270\260\353\212\245 \354\202\264\355\216\264\353\263\264\352\270\260\n            </button>\n          </motion.div>\n        </section>\n\n        {/* Social Proof */}\n        <section className=\"py-12 bg-slate-50 border-y border-[#E2E8F0]/50\">\n          <div className=\"max-w-7xl mx-auto px-6 text-center\">\n            <p className=\"text-sm font-semibold text-[#64748b] uppercase tracking-widest mb-8\">\354\265\234\352\263\240\354\235\230 \352\270\260\354\227\205 \354\240\204\353\254\270\352\260\200\353\223\244\354\235\264 \354\213\240\353\242\260\355\225\251\353\213\210\353\213\244</p>\n            <div className=\"flex flex-wrap justify-center gap-12 opacity-60 grayscale hover:grayscale-0 transition-all duration-500 font-bold text-xl text-[#002045]\">\n              <div>TechNova</div>\n              <div>GlobalCorp</div>\n              <div>AlphaSystems</div>\n              <div>NexusGroup</div>\n            </div>\n          </div>\n        </section>\n\n        {/* Bento Grid (No Gradients) */}\n        <section className=\"py-24 px-6 max-w-7xl mx-auto\">\n          <div className=\"text-center mb-16\">\n            <h2 className=\"text-3xl font-bold text-[#002045] mb-4\">\355\224\204\353\246\254\353\257\270\354\227\204 \353\217\204\352\265\254 \353\252\250\354\235\214</h2>\n            <p className=\"text-[#64748b] max-w-xl mx-auto\">\354\225\204\353\246\204\353\213\265\352\262\214 \353\224\224\354\236\220\354\235\270\353\220\234 \353\213\250\354\235\274 \355\224\214\353\236\253\355\217\274\354\227\220\354\204\234 \354\273\244\353\246\254\354\226\264 \353\260\234\354\240\204\354\235\204 \352\263\204\355\232\215\355\225\230\353\212\224 \353\215\260 \355\225\204\354\232\224\355\225\234 \353\252\250\353\223\240 \352\262\203.</p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6\">\n            {/* Resume AI */}\n            <div onClick={() => onNavigate(\'resume\')} className={`md:col-span-8 bg-white border border-[#E2E8F0] rounded-xl p-8 cursor-pointer ${SHADOW} ${HOVER_SHADOW} transition-all duration-300 flex flex-col md:flex-row gap-8 items-center`}>\n              <div className=\"flex-1\">\n                <div className=\"w-12 h-12 rounded-lg bg-[#f0f3ff] text-[#002045] flex items-center justify-center mb-6\">\n                  <Bot size={24} />\n                </div>\n                <h3 className=\"text-2xl font-bold text-[#002045] mb-3\">\354\236\220\352\270\260\354\206\214\352\260\234\354\204\234 AI \354\226\264\354\213\234\354\212\244\355\204\264\355\212\270</h3>\n                <p className=\"text-[#64748b] mb-6 leading-relaxed\">\352\263\240\352\270\211 \354\236\220\354\227\260\354\226\264 \354\262\230\353\246\254\353\245\274 \355\231\234\354\232\251\355\225\230\354\227\254 \355\212\271\354\240\225 \354\247\201\353\254\264 \354\204\244\353\252\205\354\227\220 \353\247\236\352\262\214 \354\236\220\352\270\260\354\206\214\352\260\234\354\204\234\353\245\274 \354\246\211\354\213\234 \353\247\236\354\266\244 \354\204\244\354\240\225\355\225\230\354\204\270\354\232\224. \354\240\225\355\231\225\354\204\261\354\234\274\353\241\234 \353\217\213\353\263\264\354\235\264\354\204\270\354\232\224.</p>\n                <div className=\"text-[#38A169] font-semibold flex items-center gap-2\">\n                  \354\226\264\354\213\234\354\212\244\355\204\264\355\212\270 \354\202\254\354\232\251\355\225\264\353\263\264\352\270\260 <ArrowRight size={16} />\n                </div>\n              </div>\n              <div className=\"flex-1 w-full h-48 md:h-full relative rounded-lg overflow-hidden border border-[#E2E8F0] bg-slate-100\">\n                 <img src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBybMZeB8Bk8p6PDgP4PrIrSyEot5uvMpmo-CJjCF90IZxEYF1Px7SJi8uochDyuFrGF3g3Qh_D3QkkQwu0EKG1NG5NQDXxIow82J8SWMfCZ3XCy2TA5imxsn2dHyJW7iDtQvvwB8FebejVZpoecY9OpaxLJGAuD-tWY0GtgWKVfHeFqDufHUZa9kQjgdACwiPK7cjv7OM20w_Gchb_sKECPBMGabXjKzukqX0XpaBXmjTysLpjFdKUnQ\" alt=\"Resume AI\" className=\"absolute inset-0 w-full h-full object-cover\" />\n              </div>\n            </div>\n\n            {/* Portfolio */}\n            <div onClick={() => onNavigate(\'portfolio\')} className={`md:col-span-4 bg-white border border-[#E2E8F0] rounded-xl p-8 cursor-pointer ${SHADOW} ${HOVER_SHADOW} transition-all duration-300 flex flex-col justify-between`}>\n              <div>\n                <div className=\"w-12 h-12 rounded-lg bg-slate-100 text-[#002045] flex items-center justify-center mb-6\">\n                  <LayoutDashboard size={24} />\n                </div>\n                <h3 className=\"text-2xl font-bold text-[#002045] mb-3\">\355\217\254\355\212\270\355\217\264\353\246\254\354\230\244 \353\271\214\353\215\224</h3>\n                <p className=\"text-[#64748b] mb-6 leading-relaxed\">\354\240\204\353\254\270\354\204\261\354\235\204 \352\260\225\354\241\260\355\225\230\353\212\224 \353\206\200\353\235\274\354\232\264 \354\236\220\353\217\231 \354\203\235\354\204\261 \353\240\210\354\235\264\354\225\204\354\233\203\354\234\274\353\241\234 \354\236\221\354\227\205\353\254\274\354\235\204 \354\204\240\353\263\264\354\235\264\354\204\270\354\232\224.</p>\n              </div>\n            </div>\n\n            {/* Metrics (Flat color instead of gradient) */}\n            <div className={`md:col-span-4 bg-[#1a365d] text-white rounded-xl p-8 ${SHADOW} ${HOVER_SHADOW} transition-all duration-300 flex flex-col justify-between`}>\n              <div>\n                <div className=\"w-12 h-12 rounded-lg bg-white/10 flex items-center justify-center mb-6\">\n                  <TrendingUp size={24} />\n                </div>\n                <h3 className=\"text-2xl font-bold mb-3\">\354\273\244\353\246\254\354\226\264 \353\266\204\354\204\235</h3>\n                <p className=\"text-white/80 leading-relaxed\">\354\247\200\354\233\220\354\204\234, \353\251\264\354\240\221 \354\240\204\355\231\230\354\234\250 \353\260\217 \354\213\234\352\260\204 \352\262\275\352\263\274\354\227\220 \353\224\260\353\245\270 \352\270\260\354\210\240 \354\204\261\354\236\245\354\235\204 \354\266\224\354\240\201\355\225\230\354\204\270\354\232\224.</p>\n              </div>\n            </div>\n\n            {/* Dashboard */}\n            <div onClick={() => onNavigate(\'dashboard\')} className={`md:col-span-8 bg-white border border-[#E2E8F0] rounded-xl p-8 cursor-pointer ${SHADOW} ${HOVER_SHADOW} transition-all duration-300 flex flex-col md:flex-row-reverse gap-8 items-center`}>\n              <div className=\"flex-1\">\n                <div className=\"w-12 h-12 rounded-lg bg-[#e7eeff] text-[#1a365d] flex items-center justify-center mb-6\">\n                  <Kanban size={24} />\n                </div>\n                <h3 className=\"text-2xl font-bold text-[#002045] mb-3\">\354\244\221\354\225\231 \353\214\200\354\213\234\353\263\264\353\223\234</h3>\n                <p className=\"text-[#64748b] mb-6 leading-relaxed\">\354\240\204\353\254\270\354\240\201\354\235\270 \354\247\200\355\234\230\354\206\214\354\236\205\353\213\210\353\213\244. \354\227\260\353\235\275\354\262\230\353\245\274 \354\240\225\353\246\254\355\225\230\352\263\240 \355\233\204\354\206\215 \354\241\260\354\271\230\353\245\274 \354\230\210\354\225\275\355\225\230\353\251\260 \355\225\230\353\202\230\354\235\230 \355\206\265\355\225\251\353\220\234 \352\263\265\352\260\204\354\227\220\354\204\234 \354\240\204\354\262\264 \352\265\254\354\247\201 \354\233\214\355\201\254\355\224\214\353\241\234\353\245\274 \352\264\200\353\246\254\355\225\230\354\204\270\354\232\224.</p>\n              </div>\n              <div className=\"flex-1 w-full h-48 relative rounded-lg border border-[#E2E8F0] bg-slate-50 flex items-center justify-center\">\n                 <div className=\"text-slate-300 flex flex-col items-center gap-2\">\n                    <TrendingUp size={48} />\n                    <span className=\"font-semibold text-sm tracking-wider\">\354\247\200\355\234\230\354\206\214</span>\n                 </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      </main>\n      \n      <footer className=\"w-full py-8 bg-slate-50 border-t border-[#E2E8F0] mt-auto text-sm text-[#64748b]\">\n        <div className=\"max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4\">\n           <div className=\"font-bold text-[#002045]\">CareerCraft</div>\n           <div>\302\251 2026 CareerCraft. \353\252\250\353\223\240 \352\266\214\353\246\254 \353\263\264\354\234\240.</div>\n           <div className=\"flex gap-4\">\n             <a href=\"#\" className=\"hover:text-[#002045]\">\354\202\254\354\235\264\355\212\270\353\247\265</a>\n             <a href=\"#\" className=\"hover:text-[#002045]\">\352\260\234\354\235\270\354\240\225\353\263\264 \354\262\230\353\246\254\353\260\251\354\271\250</a>\n           </div>\n        </div>\n      </footer>\n    </div>\n  );\n};\n\n// --- 2. Dashboard View ---\nconst DashboardView = ({ onNavigate }: { onNavigate: (view: ViewState) => void }) => {\n  return (\n    <div className=\"min-h-screen bg-[#F8FAFC] flex font-sans\">\n      {/* Sidebar */}\n      <aside className=\"hidden md:flex flex-col w-64 bg-[#f0f3ff] border-r border-[#E2E8F0] p-4 fixed h-full z-20\">\n        <div className=\"mb-8 px-2 flex items-center gap-3 cursor-pointer\" onClick={() => onNavigate(\'landing\')}>\n          <div className=\"w-10 h-10 rounded-full bg-[#1a365d] text-white flex items-center justify-center\">\n            <Briefcase size={20} />\n          </div>\n          <div>\n            <h1 className=\"font-bold text-[#002045] leading-tight\">\355\224\204\353\241\234\354\240\235\355\212\270 \354\233\214\355\201\254\354\212\244\355\216\230\354\235\264\354\212\244</h1>\n            <p className=\"text-xs text-[#64748b]\">\354\227\220\353\224\224\355\204\260 v2.4</p>\n          </div>\n        </div>\n        \n        <button className=\"mb-6 w-full py-3 bg-[#38A169] text-white rounded-md font-semibold text-sm flex items-center justify-center gap-2 hover:bg-opacity-90 transition-colors shadow-sm\">\n          <Plus size={18} /> \354\203\210 \355\224\204\353\241\234\354\240\235\355\212\270\n        </button>\n        \n        <nav className=\"flex flex-col gap-1\">\n          <a href=\"#\" className=\"flex items-center gap-3 bg-white text-[#002045] font-semibold border border-[#E2E8F0] rounded-lg px-4 py-3 text-sm shadow-sm\">\n            <Folder size={18} className=\"text-[#002045]\" /> \353\202\264 \355\224\204\353\241\234\354\240\235\355\212\270\n          </a>\n          <a href=\"#\" className=\"flex items-center gap-3 text-[#64748b] hover:bg-white/50 rounded-lg px-4 py-3 text-sm font-medium transition-colors\">\n            <LayoutDashboard size={18} /> \355\205\234\355\224\214\353\246\277\n          </a>\n          <a href=\"#\" className=\"flex items-center gap-3 text-[#64748b] hover:bg-white/50 rounded-lg px-4 py-3 text-sm font-medium transition-colors\">\n            <Bot size={18} /> AI \354\226\264\354\213\234\354\212\244\355\204\264\355\212\270\n          </a>\n          <a href=\"#\" className=\"flex items-center gap-3 text-[#64748b] hover:bg-white/50 rounded-lg px-4 py-3 text-sm font-medium transition-colors mt-auto\">\n            <Settings size={18} /> \354\204\244\354\240\225\n          </a>\n        </nav>\n      </aside>\n\n      {/* Main Content */}\n      <main className=\"flex-1 md:ml-64 p-8\">\n        <div className=\"max-w-5xl mx-auto\">\n          <section className=\"mb-10\">\n            <h2 className=\"text-4xl font-bold text-[#002045] mb-2 tracking-tight\">\353\260\230\352\260\200\354\233\214\354\232\224, Alex\353\213\230.</h2>\n            <p className=\"text-[#64748b] text-lg\">\354\240\204\353\254\270 \354\233\214\355\201\254\354\212\244\355\216\230\354\235\264\354\212\244\354\235\230 \354\232\224\354\225\275\354\236\205\353\213\210\353\213\244.</p>\n          </section>\n\n          <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n            {/* Active Projects */}\n            <div className=\"lg:col-span-2 flex flex-col gap-4\">\n              <div className=\"flex justify-between items-center mb-2\">\n                <h3 className=\"text-2xl font-bold text-[#002045]\">\354\247\204\355\226\211 \354\244\221\354\235\270 \355\224\204\353\241\234\354\240\235\355\212\270</h3>\n                <button className=\"text-[#38A169] hover:underline font-semibold text-sm flex items-center gap-1\">\n                  \354\240\204\354\262\264 \353\263\264\352\270\260 <ArrowRight size={16} />\n                </button>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                {/* Resume Project Card */}\n                <div onClick={() => onNavigate(\'resume\')} className={`bg-white border border-[#E2E8F0] rounded-xl p-6 flex flex-col cursor-pointer ${SHADOW} ${HOVER_SHADOW} transition-all`}>\n                  <div className=\"flex justify-between items-start mb-4\">\n                    <div className=\"p-2 bg-[#f0f3ff] rounded-md text-[#1a365d]\">\n                      <FileText size={20} />\n                    </div>\n                    <span className=\"bg-[#38A169]/10 text-[#38A169] text-xs font-bold px-2 py-1 rounded\">75% \354\231\204\353\243\214</span>\n                  </div>\n                  <h4 className=\"font-bold text-[#002045] text-lg mb-1\">\354\213\234\353\213\210\354\226\264 \352\260\234\353\260\234\354\236\220 \354\235\264\353\240\245\354\204\234</h4>\n                  <p className=\"text-sm text-[#64748b] mb-6\">\355\225\200\355\205\214\355\201\254 \354\227\255\355\225\240 \355\203\200\352\262\237\355\214\205. 2\354\213\234\352\260\204 \354\240\204 \353\247\210\354\247\200\353\247\211 \355\216\270\354\247\221.</p>\n                  <div className=\"mt-auto\">\n                    <div className=\"w-full bg-slate-100 rounded-full h-1.5 mb-3\">\n                      <div className=\"bg-[#38A169] h-1.5 rounded-full\" style={{ width: \'75%\' }}></div>\n                    </div>\n                    <div className=\"flex justify-end\">\n                      <button className=\"px-4 py-2 border border-[#E2E8F0] text-[#002045] text-sm font-semibold rounded hover:bg-slate-50 transition-colors\">\355\216\270\354\247\221</button>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Portfolio Project Card */}\n                <div onClick={() => onNavigate(\'portfolio\')} className={`bg-white border border-[#E2E8F0] rounded-xl p-6 flex flex-col cursor-pointer ${SHADOW} ${HOVER_SHADOW} transition-all`}>\n                  <div className=\"flex justify-between items-start mb-4\">\n                    <div className=\"p-2 bg-slate-100 rounded-md text-[#64748b]\">\n                      <MonitorSmartphone size={20} />\n                    </div>\n                    <span className=\"bg-slate-100 text-[#64748b] text-xs font-bold px-2 py-1 rounded\">AI \352\262\200\355\206\240 \353\214\200\352\270\260 \354\244\221</span>\n                  </div>\n                  <h4 className=\"font-bold text-[#002045] text-lg mb-1\">UX \355\217\254\355\212\270\355\217\264\353\246\254\354\230\244 2024</h4>\n                  <p className=\"text-sm text-[#64748b] mb-6\">\354\202\254\353\241\200 \354\227\260\352\265\254 \355\217\254\353\247\244\355\214\205. 1\354\235\274 \354\240\204 \353\247\210\354\247\200\353\247\211 \355\216\270\354\247\221.</p>\n                  <div className=\"mt-auto\">\n                    <div className=\"w-full bg-slate-100 rounded-full h-1.5 mb-3\">\n                      <div className=\"bg-slate-300 h-1.5 rounded-full\" style={{ width: \'100%\' }}></div>\n                    </div>\n                    <div className=\"flex justify-end\">\n                      <button className=\"px-4 py-2 border border-[#E2E8F0] text-[#002045] text-sm font-semibold rounded hover:bg-slate-50 transition-colors flex items-center gap-1\">\n                        <Sparkles size={14} /> \352\262\200\355\206\240\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Right Column: Activity & Templates */}\n            <div className=\"flex flex-col gap-6 lg:mt-[3.25rem]\">\n              <div className={`bg-white border border-[#E2E8F0] rounded-xl p-6 ${SHADOW}`}>\n                <h3 className=\"font-bold text-[#002045] text-lg mb-6\">\354\265\234\352\267\274 \355\231\234\353\217\231</h3>\n                <div className=\"relative pl-5 border-l-2 border-slate-100 space-y-6\">\n                  <div className=\"relative\">\n                    <div className=\"absolute -left-[27px] top-1 w-3 h-3 rounded-full bg-white border-2 border-[#1a365d]\"></div>\n                    <p className=\"text-xs text-[#64748b] mb-1\">\354\230\244\353\212\230, \354\230\244\354\240\204 10:23</p>\n                    <p className=\"text-sm font-medium text-[#002045]\">\"\354\213\234\353\213\210\354\226\264 \352\260\234\353\260\234\354\236\220 \354\235\264\353\240\245\354\204\234\"\353\245\274 PDF\353\241\234 \353\202\264\353\263\264\353\203\210\354\212\265\353\213\210\353\213\244.</p>\n                  </div>\n                  <div className=\"relative\">\n                    <div className=\"absolute -left-[27px] top-1 w-3 h-3 rounded-full bg-white border-2 border-[#E2E8F0]\"></div>\n                    <p className=\"text-xs text-[#64748b] mb-1\">\354\226\264\354\240\234, \354\230\244\355\233\204 4:45</p>\n                    <p className=\"text-sm font-medium text-[#002045]\">AI\352\260\200 \"UX \355\217\254\355\212\270\355\217\264\353\246\254\354\230\244\"\354\235\230 \354\232\224\354\225\275\354\235\204 \354\203\235\354\204\261\355\226\210\354\212\265\353\213\210\353\213\244.</p>\n                  </div>\n                </div>\n              </div>\n\n              <div className={`bg-white border border-[#E2E8F0] rounded-xl p-6 ${SHADOW}`}>\n                <h3 className=\"font-bold text-[#002045] text-lg mb-4\">\354\266\224\354\262\234 \355\205\234\355\224\214\353\246\277</h3>\n                <div className=\"space-y-3\">\n                  <button className=\"w-full flex items-center gap-4 p-3 rounded hover:bg-slate-50 transition-colors text-left\">\n                    <div className=\"w-10 h-10 bg-slate-100 rounded flex items-center justify-center text-[#1a365d]\">\n                      <Briefcase size={20} />\n                    </div>\n                    <div>\n                      <h4 className=\"font-semibold text-sm text-[#002045]\">\352\262\275\354\230\201\354\247\204 \353\270\214\353\246\254\355\225\221</h4>\n                      <p className=\"text-xs text-[#64748b]\">\352\271\224\353\201\224\355\225\230\352\263\240 \354\240\204\353\254\270\354\240\201\354\235\270 \353\240\210\354\235\264\354\225\204\354\233\203.</p>\n                    </div>\n                  </button>\n                  <button className=\"w-full flex items-center gap-4 p-3 rounded hover:bg-slate-50 transition-colors text-left\">\n                    <div className=\"w-10 h-10 bg-slate-100 rounded flex items-center justify-center text-[#1a365d]\">\n                      <Palette size={20} />\n                    </div>\n                    <div>\n                      <h4 className=\"font-semibold text-sm text-[#002045]\">\355\201\254\353\246\254\354\227\220\354\235\264\355\213\260\353\270\214 \353\224\224\353\240\211\355\204\260</h4>\n                      <p className=\"text-xs text-[#64748b]\">\354\213\234\352\260\201\354\240\201 \352\263\204\354\270\265 \352\265\254\354\241\260 \352\260\225\354\241\260.</p>\n                    </div>\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </main>\n    </div>\n  );\n};\n\n// --- 3. Resume Editor View ---\nconst ResumeEditorView = ({ onNavigate }: { onNavigate: (view: ViewState) => void }) => {\n  return (\n    <div className=\"h-screen bg-[#F8FAFC] flex flex-col font-sans overflow-hidden\">\n      {/* Editor Header */}\n      <header className=\"h-16 flex-none bg-white border-b border-[#E2E8F0] flex justify-between items-center px-6 z-10\">\n        <div className=\"flex items-center gap-6\">\n          <button onClick={() => onNavigate(\'dashboard\')} className=\"font-bold text-xl text-[#002045] tracking-tight hover:opacity-80\">CareerCraft</button>\n          <nav className=\"hidden md:flex gap-6 h-full\">\n            <span className=\"text-[#64748b] text-sm font-medium h-full flex items-center\">\353\214\200\354\213\234\353\263\264\353\223\234</span>\n            <span className=\"text-[#38A169] text-sm font-bold border-b-2 border-[#38A169] h-full flex items-center\">\354\235\264\353\240\245\354\204\234</span>\n            <span className=\"text-[#64748b] text-sm font-medium h-full flex items-center\">\355\217\254\355\212\270\355\217\264\353\246\254\354\230\244</span>\n          </nav>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <span className=\"text-xs text-[#64748b] hidden sm:block\">\353\247\210\354\247\200\353\247\211 \354\240\200\354\236\245: 2\353\266\204 \354\240\204</span>\n          <button className=\"px-4 py-2 border border-[#E2E8F0] rounded text-[#002045] text-sm font-semibold hover:bg-slate-50\">\353\202\264\353\263\264\353\202\264\352\270\260</button>\n          <button className=\"px-4 py-2 bg-[#38A169] text-white rounded text-sm font-semibold hover:bg-opacity-90 shadow-sm\">\354\240\200\354\236\245</button>\n          <div className=\"w-8 h-8 rounded-full bg-slate-200 ml-2 flex items-center justify-center text-[#64748b]\"><User size={16}/></div>\n        </div>\n      </header>\n\n      <div className=\"flex-1 flex overflow-hidden p-6 gap-6 max-w-7xl mx-auto w-full\">\n        {/* Left: Editor Area */}\n        <div className={`flex-1 bg-white rounded-xl border border-[#E2E8F0] ${SHADOW} flex flex-col relative overflow-hidden`}>\n          {/* Floating Toolbar */}\n          <div className=\"absolute top-4 left-1/2 -translate-x-1/2 bg-white border border-[#E2E8F0] shadow-md rounded-full px-4 py-2 flex items-center gap-1 z-10\">\n             <button className=\"p-1.5 hover:bg-slate-100 rounded text-[#64748b]\"><Bold size={16}/></button>\n             <button className=\"p-1.5 hover:bg-slate-100 rounded text-[#64748b]\"><Italic size={16}/></button>\n             <button className=\"p-1.5 hover:bg-slate-100 rounded text-[#64748b]\"><Underline size={16}/></button>\n             <div className=\"w-px h-4 bg-[#E2E8F0] mx-1\"></div>\n             <button className=\"p-1.5 hover:bg-slate-100 rounded text-[#64748b]\"><List size={16}/></button>\n             <button className=\"p-1.5 hover:bg-slate-100 rounded text-[#64748b]\"><ListOrdered size={16}/></button>\n             <div className=\"w-px h-4 bg-[#E2E8F0] mx-1\"></div>\n             <button className=\"p-1.5 hover:bg-slate-100 rounded text-[#64748b]\"><Undo size={16}/></button>\n             <button className=\"p-1.5 hover:bg-slate-100 rounded text-[#64748b]\"><Redo size={16}/></button>\n          </div>\n\n          <div className=\"flex-1 overflow-y-auto p-12 md:p-20\">\n            <div className=\"max-w-[700px] mx-auto text-[#002045]\">\n              <h1 className=\"text-4xl font-bold mb-2\">\354\225\214\353\240\211\354\212\244 \354\241\264\354\212\250</h1>\n              <p className=\"text-[#64748b] mb-10 text-sm\">alex.johnson@email.com | (555) 123-4567 | \354\203\214\355\224\204\353\236\200\354\213\234\354\212\244\354\275\224, \354\272\230\353\246\254\355\217\254\353\213\210\354\225\204 | linkedin.com/in/alexj</p>\n              \n              <h2 className=\"text-xl font-bold border-b border-[#E2E8F0] pb-2 mb-4\">\354\240\204\353\254\270 \354\232\224\354\225\275</h2>\n              <p className=\"mb-8 leading-relaxed text-[15px]\">B2B SaaS \353\266\204\354\225\274\354\227\220\354\204\234 8\353\205\204 \354\235\264\354\203\201\354\235\230 \352\262\275\355\227\230\354\235\204 \354\214\223\354\235\200 \354\204\261\352\263\274 \354\247\200\355\226\245\354\240\201 \354\210\230\354\204\235 \354\240\234\355\222\210 \352\264\200\353\246\254\354\236\220\354\236\205\353\213\210\353\213\244. \355\231\225\354\236\245 \352\260\200\353\212\245\355\225\234 \354\206\214\355\224\204\355\212\270\354\233\250\354\226\264 \354\206\224\353\243\250\354\205\230\354\235\204 \354\240\234\352\263\265\355\225\230\354\227\254 \353\247\244\354\266\234 \354\204\261\354\236\245\354\235\204 \354\243\274\353\217\204\355\225\230\352\263\240 \354\202\254\354\232\251\354\236\220 \354\234\240\354\247\200\354\234\250\354\235\204 \355\226\245\354\203\201\354\213\234\355\202\244\352\270\260 \354\234\204\355\225\264 \352\265\220\354\260\250 \352\270\260\353\212\245 \355\214\200\354\235\204 \354\235\264\353\201\210 \354\236\205\354\246\235\353\220\234 \354\213\244\354\240\201\354\235\204 \353\263\264\354\234\240\355\225\230\352\263\240 \354\236\210\354\212\265\353\213\210\353\213\244. \354\225\240\354\236\220\354\235\274 \353\260\251\353\262\225\353\241\240, \353\215\260\354\235\264\355\204\260 \352\270\260\353\260\230 \354\235\230\354\202\254 \352\262\260\354\240\225 \353\260\217 \354\240\234\355\222\210 \354\240\204\353\236\265\354\235\204 \353\271\204\354\246\210\353\213\210\354\212\244 \353\252\251\355\221\234\354\227\220 \353\247\236\354\266\224\353\212\224 \353\215\260 \354\240\204\353\254\270\354\204\261\354\235\264 \354\236\210\354\212\265\353\213\210\353\213\244.</p>\n              \n              <h2 className=\"text-xl font-bold border-b border-[#E2E8F0] pb-2 mb-4\">\352\262\275\353\240\245</h2>\n              <div className=\"mb-6 relative group\">\n                 {/* Hover edit icon simulated */}\n                 <div className=\"absolute -left-8 top-1 opacity-0 group-hover:opacity-100 text-[#38A169] transition-opacity cursor-pointer\">\n                    <Edit2 size={16}/>\n                 </div>\n                 <div className=\"flex justify-between items-baseline mb-1\">\n                   <h3 className=\"font-bold text-[#1a365d]\">\354\210\230\354\204\235 \354\240\234\355\222\210 \352\264\200\353\246\254\354\236\220</h3>\n                   <span className=\"text-sm text-[#64748b]\">2020\353\205\204 1\354\233\224 - \355\230\204\354\236\254</span>\n                 </div>\n                 <p className=\"text-sm text-[#64748b] mb-3\">TechFlow Solutions | \354\203\214\355\224\204\353\236\200\354\213\234\354\212\244\354\275\224, \354\272\230\353\246\254\355\217\254\353\213\210\354\225\204</p>\n                 <ul className=\"list-disc pl-5 space-y-2 text-[15px] leading-relaxed\">\n                   <li>\354\203\210\353\241\234\354\232\264 \353\266\204\354\204\235 \353\214\200\354\213\234\353\263\264\353\223\234\354\235\230 \352\260\234\353\260\234 \353\260\217 \354\266\234\354\213\234\353\245\274 \354\243\274\353\217\204\355\225\230\354\227\254 1\353\266\204\352\270\260 \353\202\264\354\227\220 \354\202\254\354\232\251\354\236\220 \354\260\270\354\227\254\353\217\204\353\245\274 40% \354\246\235\352\260\200\354\213\234\354\274\260\354\212\265\353\213\210\353\213\244.</li>\n                   <li className=\"bg-[#f0f3ff] border-b-2 border-[#1a365d] -mx-1 px-1 rounded-sm\">\354\225\240\354\236\220\354\235\274/\354\212\244\355\201\254\353\237\274 \353\260\251\353\262\225\353\241\240\354\235\204 \354\202\254\354\232\251\355\225\230\354\227\254 12\353\252\205\354\235\230 \354\227\224\354\247\200\353\213\210\354\226\264\354\231\200 \353\224\224\354\236\220\354\235\264\353\204\210\353\241\234 \352\265\254\354\204\261\353\220\234 \352\265\220\354\260\250 \352\270\260\353\212\245 \355\214\200\354\235\204 \352\264\200\353\246\254\355\226\210\354\212\265\353\213\210\353\213\244.</li>\n                   <li>\352\264\221\353\262\224\354\234\204\355\225\234 \354\213\234\354\236\245 \354\241\260\354\202\254 \353\260\217 \352\263\240\352\260\235 \354\235\270\355\204\260\353\267\260\353\245\274 \354\210\230\355\226\211\355\225\230\354\227\254 \354\243\274\354\232\224 \353\254\270\354\240\234\354\240\220\354\235\204 \355\214\214\354\225\205\355\225\230\352\263\240 \354\241\260\354\202\254 \352\262\260\352\263\274\353\245\274 \354\213\244\355\226\211 \352\260\200\353\212\245\355\225\234 \354\240\234\355\222\210 \354\232\224\352\265\254 \354\202\254\355\225\255\354\234\274\353\241\234 \354\240\204\355\231\230\355\226\210\354\212\265\353\213\210\353\213\244.</li>\n                 </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Right: AI Assistant */}\n        <div className={`w-[320px] flex-none bg-white rounded-xl border border-[#E2E8F0] ${SHADOW} flex flex-col overflow-hidden`}>\n          <div className=\"p-4 bg-slate-50 border-b border-[#E2E8F0] flex items-center gap-3\">\n             <div className=\"w-8 h-8 rounded-full bg-[#1a365d] text-white flex items-center justify-center\">\n               <Bot size={16}/>\n             </div>\n             <div>\n               <h3 className=\"font-bold text-sm text-[#002045]\">AI \354\226\264\354\213\234\354\212\244\355\204\264\355\212\270</h3>\n               <p className=\"text-[11px] text-[#64748b]\">\354\213\244\354\213\234\352\260\204 \353\266\204\354\204\235 \355\231\234\354\204\261\355\231\224\353\220\250</p>\n             </div>\n          </div>\n          \n          <div className=\"flex border-b border-[#E2E8F0]\">\n            <button className=\"flex-1 py-3 text-center border-b-2 border-[#38A169] text-[#38A169] font-bold text-sm\">\355\224\274\353\223\234\353\260\261</button>\n            <button className=\"flex-1 py-3 text-center text-[#64748b] font-semibold text-sm hover:text-[#002045]\">\355\202\244\354\233\214\353\223\234</button>\n          </div>\n\n          <div className=\"flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50\">\n             {/* Score */}\n             <div className=\"bg-white p-4 rounded-lg border border-[#E2E8F0] shadow-sm flex items-center gap-4\">\n                <div className=\"relative w-12 h-12 flex items-center justify-center flex-shrink-0\">\n                   <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 36 36\">\n                     <path className=\"text-slate-200\" d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"3\"></path>\n                     <path className=\"text-[#38A169]\" strokeDasharray=\"85, 100\" d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"3\"></path>\n                   </svg>\n                   <span className=\"absolute text-sm font-bold text-[#002045]\">85</span>\n                </div>\n                <div>\n                   <h4 className=\"font-bold text-sm text-[#002045] mb-0.5\">\352\260\225\353\240\245\355\225\234 \354\235\264\353\240\245\354\204\234</h4>\n                   <p className=\"text-[11px] text-[#64748b] leading-tight\">\355\233\214\353\245\255\355\225\234 \355\226\211\353\217\231 \353\217\231\354\202\254\353\245\274 \354\202\254\354\232\251\355\226\210\354\247\200\353\247\214 \353\215\224 \353\247\216\354\235\200 \354\240\225\353\237\211\355\231\224 \352\260\200\353\212\245\355\225\234 \352\262\260\352\263\274\352\260\200 \355\225\204\354\232\224\355\225\251\353\213\210\353\213\244.</p>\n                </div>\n             </div>\n\n             {/* Suggestion 1 */}\n             <div className=\"bg-white p-4 rounded-lg border border-[#E2E8F0] shadow-sm hover:shadow-md transition-shadow\">\n               <div className=\"flex gap-2 items-start mb-3\">\n                 <Lightbulb size={16} className=\"text-[#1a365d] flex-shrink-0 mt-0.5\"/>\n                 <div>\n                   <h4 className=\"font-bold text-sm text-[#002045]\">\352\270\200\353\250\270\353\246\254 \352\270\260\355\230\270 \352\260\225\355\231\224</h4>\n                   <p className=\"text-xs text-[#64748b] mt-1 leading-snug\">\"\352\265\220\354\260\250 \352\270\260\353\212\245 \355\214\200\354\235\204 \352\264\200\353\246\254\355\226\210\354\212\265\353\213\210\353\213\244\" \353\214\200\354\213\240 \355\214\200\354\235\230 \354\230\201\355\226\245\354\235\204 \354\240\225\353\237\211\355\231\224\355\225\264 \353\263\264\354\204\270\354\232\224.</p>\n                 </div>\n               </div>\n               <div className=\"bg-[#f0f3ff] p-3 rounded text-xs border-l-2 border-[#1a365d] mb-3 text-[#002045] leading-relaxed\">\n                 \"12\354\235\270 \352\267\234\353\252\250\354\235\230 \354\225\240\354\236\220\354\235\274 \355\214\200\354\235\204 \354\247\200\355\234\230\355\225\230\354\227\254 3\352\260\234\354\235\230 \354\243\274\354\232\224 \352\270\260\353\212\245 \353\246\264\353\246\254\354\212\244\353\245\274 \354\230\210\354\240\225\353\263\264\353\213\244 \354\235\274\354\260\215 \354\240\234\352\263\265\355\225\230\352\263\240 \354\266\234\354\213\234 \352\270\260\352\260\204\354\235\204 15% \353\213\250\354\266\225\355\226\210\354\212\265\353\213\210\353\213\244.\"\n               </div>\n               <div className=\"flex gap-2\">\n                 <button className=\"px-3 py-1.5 bg-[#e7eeff] hover:bg-[#d8e3fa] text-[#1a365d] rounded text-xs font-bold transition-colors\">\354\240\201\354\232\251</button>\n                 <button className=\"px-3 py-1.5 text-[#64748b] hover:text-[#002045] rounded text-xs font-medium transition-colors\">\353\254\264\354\213\234</button>\n               </div>\n             </div>\n\n             {/* Suggestion 2 */}\n             <div className=\"bg-white p-4 rounded-lg border border-[#E2E8F0] shadow-sm\">\n               <div className=\"flex gap-2 items-start\">\n                 <CheckCircle2 size={16} className=\"text-[#38A169] flex-shrink-0 mt-0.5\"/>\n                 <div>\n                   <h4 className=\"font-bold text-sm text-[#002045]\">\354\226\264\354\241\260 \355\231\225\354\235\270</h4>\n                   <p className=\"text-xs text-[#64748b] mt-1 leading-snug\">\354\240\204\353\254\270 \354\232\224\354\225\275\354\235\264 \353\247\244\354\232\260 \352\260\225\353\240\245\355\225\230\352\263\240 \352\266\214\354\234\204 \354\236\210\354\212\265\353\213\210\353\213\244.</p>\n                 </div>\n               </div>\n             </div>\n          </div>\n\n          {/* Chat Input */}\n          <div className=\"p-4 border-t border-[#E2E8F0] bg-white\">\n             <div className=\"relative\">\n               <input type=\"text\" placeholder=\"AI\354\227\220\352\262\214 \353\213\244\354\213\234 \354\223\260\352\270\260 \354\232\224\354\262\255...\" className=\"w-full bg-slate-50 border border-[#E2E8F0] rounded-full pl-4 pr-10 py-2.5 text-sm focus:outline-none focus:border-[#1a365d] transition-colors\" />\n               <button className=\"absolute right-3 top-1/2 -translate-y-1/2 text-[#64748b] hover:text-[#1a365d]\">\n                 <Send size={16}/>\n               </button>\n             </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\n// --- 4. Portfolio Builder View ---\nconst PortfolioBuilderView = ({ onNavigate }: { onNavigate: (view: ViewState) => void }) => {\n  return (\n    <div className=\"h-screen bg-[#F8FAFC] flex flex-col font-sans overflow-hidden\">\n      {/* Header */}\n      <header className=\"h-16 flex-none bg-white border-b border-[#E2E8F0] flex justify-between items-center px-6 z-20\">\n        <div className=\"flex items-center gap-6\">\n          <button onClick={() => onNavigate(\'dashboard\')} className=\"font-bold text-xl text-[#002045] tracking-tight hover:opacity-80\">CareerCraft</button>\n          <nav className=\"hidden md:flex gap-6 h-full\">\n            <span className=\"text-[#64748b] text-sm font-medium h-full flex items-center\">\353\214\200\354\213\234\353\263\264\353\223\234</span>\n            <span className=\"text-[#64748b] text-sm font-medium h-full flex items-center\">\354\235\264\353\240\245\354\204\234</span>\n            <span className=\"text-[#38A169] text-sm font-bold border-b-2 border-[#38A169] h-full flex items-center\">\355\217\254\355\212\270\355\217\264\353\246\254\354\230\244</span>\n          </nav>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <button className=\"px-4 py-2 border border-[#E2E8F0] rounded text-[#002045] text-sm font-semibold hover:bg-slate-50 transition-colors\">\353\257\270\353\246\254\353\263\264\352\270\260</button>\n          <button className=\"px-4 py-2 bg-[#38A169] text-white rounded text-sm font-semibold hover:bg-opacity-90 shadow-sm transition-colors\">\353\260\234\355\226\211</button>\n          <div className=\"text-[#002045] text-sm font-semibold ml-2 hidden sm:block\">\355\224\204\353\241\234\355\225\204</div>\n        </div>\n      </header>\n\n      <div className=\"flex-1 flex overflow-hidden\">\n        {/* Left: Elements Sidebar */}\n        <aside className=\"w-64 bg-white border-r border-[#E2E8F0] flex flex-col z-10 flex-shrink-0\">\n          <div className=\"p-4 border-b border-[#E2E8F0]\">\n            <h2 className=\"text-xs font-bold text-[#64748b] uppercase tracking-wider\">\354\232\224\354\206\214</h2>\n          </div>\n          <div className=\"p-4 flex flex-col gap-3 overflow-y-auto\">\n            {[\n              { icon: Type, label: \'\355\205\215\354\212\244\355\212\270 \353\270\224\353\241\235\' },\n              { icon: ImageIcon, label: \'\354\235\264\353\257\270\354\247\200\' },\n              { icon: LayoutGrid, label: \'\355\224\204\353\241\234\354\240\235\355\212\270 \352\267\270\353\246\254\353\223\234\' },\n              { icon: Award, label: \'\354\212\244\355\202\254 \353\260\260\354\247\200\' },\n              { icon: Mail, label: \'\353\254\270\354\235\230 \354\226\221\354\213\235\' },\n            ].map((el, i) => (\n              <div key={i} className=\"flex flex-col gap-2 p-4 bg-white border border-[#E2E8F0] rounded-lg cursor-grab hover:border-[#1a365d] hover:shadow-sm transition-all group\">\n                <el.icon size={20} className=\"text-[#1a365d] opacity-80 group-hover:opacity-100\" />\n                <span className=\"text-sm font-semibold text-[#002045]\">{el.label}</span>\n              </div>\n            ))}\n          </div>\n        </aside>\n\n        {/* Center: Canvas */}\n        <main className=\"flex-1 bg-slate-100 overflow-y-auto p-8 flex justify-center items-start\">\n          <div className={`w-full max-w-4xl bg-white rounded-xl border border-[#E2E8F0] ${SHADOW} overflow-hidden`}>\n             {/* Browser Bar Mock */}\n             <div className=\"h-10 bg-slate-50 border-b border-[#E2E8F0] flex items-center px-4 gap-2\">\n                <div className=\"w-3 h-3 rounded-full bg-red-400\"></div>\n                <div className=\"w-3 h-3 rounded-full bg-amber-400\"></div>\n                <div className=\"w-3 h-3 rounded-full bg-green-400\"></div>\n                <div className=\"flex-1 text-center text-xs text-[#64748b] font-medium opacity-70\">my-portfolio.com</div>\n             </div>\n             \n             {/* Canvas Content */}\n             <div className=\"p-16 flex flex-col gap-12 text-center\">\n                {/* Hero Block */}\n                <div className=\"border-2 border-dashed border-transparent hover:border-[#E2E8F0] p-8 rounded-xl transition-colors relative group\">\n                  <h1 className=\"text-5xl font-bold text-[#002045] mb-6 tracking-tight\">\355\231\215\352\270\270\353\217\231</h1>\n                  <p className=\"text-xl text-[#64748b] max-w-2xl mx-auto leading-relaxed\">\353\252\251\354\240\201\352\263\274 \354\240\225\353\260\200\355\225\250\354\234\274\353\241\234 \353\224\224\354\247\200\355\204\270 \352\262\275\355\227\230\354\235\204 \354\240\234\354\236\221\355\225\230\353\212\224 \354\204\240\354\236\204 UX/UI \353\224\224\354\236\220\354\235\264\353\204\210\354\236\205\353\213\210\353\213\244.</p>\n                </div>\n\n                {/* Grid Block */}\n                <div className=\"border-2 border-dashed border-transparent hover:border-[#E2E8F0] p-8 rounded-xl transition-colors\">\n                   <h2 className=\"text-3xl font-bold text-[#002045] mb-10\">\354\204\240\354\240\225\353\220\234 \354\236\221\354\227\205\353\254\274</h2>\n                   <div className=\"grid grid-cols-2 gap-8 text-left\">\n                      {/* Proj 1 */}\n                      <div className=\"bg-white rounded-xl overflow-hidden border border-[#E2E8F0] shadow-sm\">\n                        <div className=\"h-56 bg-slate-100 relative\">\n                           <img src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDTK4vpDoKmXhvVm7kkqD0jMJ0r8ytCUlkWH9LB7-eo57n0WLCza5X5_b5qbqNm3fyPWGw_bgirfuI1nAiqLVj5ACbmr4dIRnViHKf6MzpxTTmLGjD8Hi_vrUmzAofbt2PMTsVYWzvDdvpKKc0cAhJWknfS_gYKvwoaWlNa_W718_rGs972vZrc9K8xFf9J7GfKaT6oNt4Du6m_nJsqXSp2qhkSh7vD8g7bhvFLSrOtru0H5MHAtnWR-g\" alt=\"Smart Home App\" className=\"absolute inset-0 w-full h-full object-cover\" />\n                        </div>\n                        <div className=\"p-5\">\n                           <h3 className=\"text-xl font-bold text-[#002045]\">\354\212\244\353\247\210\355\212\270 \355\231\210 \354\225\261</h3>\n                           <p className=\"text-sm text-[#64748b] mt-2\">\353\252\250\353\260\224\354\235\274 \354\225\240\355\224\214\353\246\254\354\274\200\354\235\264\354\205\230 \353\246\254\353\224\224\354\236\220\354\235\270</p>\n                        </div>\n                      </div>\n                      {/* Proj 2 */}\n                      <div className=\"bg-white rounded-xl overflow-hidden border border-[#E2E8F0] shadow-sm\">\n                        <div className=\"h-56 bg-slate-100 relative\">\n                           <img src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCbDGgBvO56cGsVoFjSxVSEJKkY9FD0qD_DyUkkaeBKr1lpETMTeV8tYo9yDyzp5a7xR0Hbgz9zLf2UYZMCZqFwicE7cpxuUpis4y99ZXWHzJ1aZmDZDRhSSrkJpLuOdZbGyzxFHIQsavSQFWetmlVjzXRRSVG73Ik0IP5WAMBxoj-GoREsCVnJqr0pzoVWzq7Hrar9JrsmJDOhqkgppMHMKT3OIj63fiAPSLXmAMs_64p2HmOEWof3PQ\" alt=\"Fintech Dashboard\" className=\"absolute inset-0 w-full h-full object-cover\" />\n                        </div>\n                        <div className=\"p-5\">\n                           <h3 className=\"text-xl font-bold text-[#002045]\">\355\225\200\355\205\214\355\201\254 \353\214\200\354\213\234\353\263\264\353\223\234</h3>\n                           <p className=\"text-sm text-[#64748b] mt-2\">\353\215\260\354\235\264\355\204\260 \354\213\234\352\260\201\355\231\224 \354\213\234\354\212\244\355\205\234</p>\n                        </div>\n                      </div>\n                   </div>\n                </div>\n             </div>\n          </div>\n        </main>\n\n        {/* Right: Styles Sidebar */}\n        <aside className=\"w-[300px] bg-white border-l border-[#E2E8F0] flex flex-col z-10 flex-shrink-0\">\n          <div className=\"p-4 border-b border-[#E2E8F0]\">\n            <h2 className=\"text-xs font-bold text-[#64748b] uppercase tracking-wider\">\354\212\244\355\203\200\354\235\274 \354\204\244\354\240\225</h2>\n          </div>\n          <div className=\"p-6 flex flex-col gap-8 overflow-y-auto\">\n             {/* Typography */}\n             <div>\n               <h3 className=\"text-sm font-bold text-[#002045] mb-4\">\355\203\200\354\235\264\355\217\254\352\267\270\353\236\230\355\224\274</h3>\n               <div className=\"space-y-4\">\n                 <div>\n                   <label className=\"block text-xs text-[#64748b] font-medium mb-1.5\">\354\240\234\353\252\251 \352\270\200\352\274\264</label>\n                   <select className=\"w-full border border-[#E2E8F0] rounded p-2 text-sm text-[#002045] focus:outline-none focus:border-[#1a365d]\">\n                     <option>Inter</option>\n                     <option>Roboto</option>\n                   </select>\n                 </div>\n                 <div>\n                   <label className=\"block text-xs text-[#64748b] font-medium mb-1.5\">\353\263\270\353\254\270 \352\270\200\352\274\264</label>\n                   <select className=\"w-full border border-[#E2E8F0] rounded p-2 text-sm text-[#002045] focus:outline-none focus:border-[#1a365d]\">\n                     <option>Inter</option>\n                     <option>Open Sans</option>\n                   </select>\n                 </div>\n               </div>\n             </div>\n             \n             <div className=\"h-px w-full bg-[#E2E8F0]\"></div>\n\n             {/* Colors */}\n             <div>\n               <h3 className=\"text-sm font-bold text-[#002045] mb-4\">\354\203\211\354\203\201</h3>\n               <div className=\"grid grid-cols-2 gap-3\">\n                 <div>\n                   <label className=\"block text-xs text-[#64748b] font-medium mb-1.5\">\352\270\260\353\263\270 \354\203\211\354\203\201</label>\n                   <div className=\"flex items-center gap-2 border border-[#E2E8F0] p-1.5 rounded cursor-pointer hover:border-[#1a365d]\">\n                     <div className=\"w-5 h-5 rounded bg-[#002045]\"></div>\n                     <span className=\"text-xs font-medium text-[#002045]\">#002045</span>\n                   </div>\n                 </div>\n                 <div>\n                   <label className=\"block text-xs text-[#64748b] font-medium mb-1.5\">\353\260\260\352\262\275\354\203\211</label>\n                   <div className=\"flex items-center gap-2 border border-[#E2E8F0] p-1.5 rounded cursor-pointer hover:border-[#1a365d]\">\n                     <div className=\"w-5 h-5 rounded bg-white border border-[#E2E8F0]\"></div>\n                     <span className=\"text-xs font-medium text-[#002045]\">#FFFFFF</span>\n                   </div>\n                 </div>\n               </div>\n             </div>\n\n             <div className=\"h-px w-full bg-[#E2E8F0]\"></div>\n\n             {/* Layout */}\n             <div>\n               <h3 className=\"text-sm font-bold text-[#002045] mb-4\">\352\260\204\352\262\251</h3>\n               <div>\n                 <label className=\"block text-xs text-[#64748b] font-medium mb-3\">\354\204\271\354\205\230 \354\227\254\353\260\261</label>\n                 <input type=\"range\" className=\"w-full accent-[#1a365d]\" min=\"0\" max=\"100\" defaultValue=\"48\" />\n                 <div className=\"flex justify-between text-xs text-[#64748b] mt-2 font-medium\">\n                   <span>\354\241\260\353\260\200\355\225\250</span>\n                   <span>\354\227\254\354\234\240\353\241\234\354\233\200</span>\n                 </div>\n               </div>\n             </div>\n          </div>\n        </aside>\n      </div>\n    </div>\n  );\n};\n\n// --- Main App Component ---\nexport default function App() {\n  const [currentView, setCurrentView] = useState<ViewState>(\'landing\');\n  const [isLoading, setIsLoading] = useState(false);\n\n  const handleNavigate = (view: ViewState) => {\n    if (view === currentView) return;\n    setIsLoading(true);\n    // Simulate network/processing delay for visual feedback\n    setTimeout(() => {\n      setCurrentView(view);\n      setIsLoading(false);\n    }, 600);\n  };\n\n  return (\n    <>\n      <AnimatePresence>\n        {isLoading && <LoadingOverlay />}\n      </AnimatePresence>\n\n      {currentView === \'landing\' && <LandingView onNavigate={handleNavigate} />}\n      {currentView === \'dashboard\' && <DashboardView onNavigate={handleNavigate} />}\n      {currentView === \'resume\' && <ResumeEditorView onNavigate={handleNavigate} />}\n      {currentView === \'portfolio\' && <PortfolioBuilderView onNavigate={handleNavigate} />}\n    </>\n  );\n}\n"
    }
    instruction: "Build the full single-file React application with Landing, Dashboard, Resume Editor, and Portfolio Builder views based on the provided screenshots and constraints."
  }
}
