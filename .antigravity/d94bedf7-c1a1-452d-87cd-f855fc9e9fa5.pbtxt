          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                \353\215\260\354\235\264\355\204\260 \352\270\260\353\260\230\354\235\230 \354\235\230\354\202\254\352\262\260\354\240\225\354\234\274\353\241\234 \354\204\234\353\271\204\354\212\244\354\235\230 \354\202\254\354\232\251\354\204\261\354\235\204 \352\267\271\353\214\200\355\231\224\355\225\234 \352\262\275\355\227\230\354\235\264 \354\236\210\354\212\265\353\213\210\353\213\244. TechFlow Solutions \354\236\254\354\247\201 \353\213\271\354\213\234, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                <span className=\"bg-[#38A169]/20 border-b-2 border-[#38A169] relative group cursor-pointer px-1 rounded mx-1\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  \352\270\260\354\241\264 7\354\235\274\354\235\264 \352\261\270\353\246\254\353\215\230 \354\204\234\353\245\230 \354\240\220\352\262\200 \354\227\205\353\254\264\353\245\274 2\354\235\274 \353\202\264 \354\262\230\353\246\254\355\225\240 \354\210\230 \354\236\210\353\217\204\353\241\235 \352\260\234\354\204\240\355\226\210\354\212\265\353\213\210\353\213\244."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
