        }
        lines {
          text: "                \353\230\220\355\225\234, \354\213\240\352\267\234 \352\270\260\353\212\245 \353\237\260\354\271\255 \352\263\274\354\240\225\354\227\220\354\204\234 \355\214\200 \352\260\204\354\235\230 \354\206\214\355\206\265 \354\230\244\353\245\230\353\245\274 \354\244\204\354\235\264\352\270\260 \354\234\204\355\225\264 \354\225\240\354\236\220\354\235\274 \353\260\251\353\262\225\353\241\240\354\235\204 \353\217\204\354\236\205\355\225\230\354\230\200\352\263\240, "
