    replacement_chunks {
      target_content: "// --- Main App Component ---"
      replacement_content: "// --- 5. Portfolio Builder View ---\nconst PortfolioView = ({ onNavigate }: { onNavigate: (view: ViewState) => void }) => {\n  return (\n    <div className=\"h-screen bg-[#F8FAFC] flex flex-col font-sans overflow-hidden\">\n      {/* Header */}\n      <header className=\"h-16 flex-none bg-white border-b border-[#E2E8F0] flex justify-between items-center px-6 z-20\">\n        <div className=\"flex items-center gap-6\">\n          <button onClick={() => onNavigate(\'dashboard\')} className=\"font-bold text-xl text-[#002045] tracking-tight hover:opacity-80\">CareerCraft</button>\n          <nav className=\"hidden md:flex gap-6 h-full\">\n            <span className=\"text-[#64748b] text-sm font-medium h-full flex items-center cursor-pointer\" onClick={() => onNavigate(\'dashboard\')}>\354\233\214\355\201\254\354\212\244\355\216\230\354\235\264\354\212\244</span>\n            <span className=\"text-[#64748b] text-sm font-medium h-full flex items-center cursor-pointer\" onClick={() => onNavigate(\'editor\')}>\354\275\224\355\214\214\354\235\274\353\237\277 \354\227\220\353\224\224\355\204\260</span>\n            <span className=\"text-[#38A169] text-sm font-bold border-b-2 border-[#38A169] h-full flex items-center gap-2\">\n              <ShieldCheck size={16}/> \355\217\254\355\212\270\355\217\264\353\246\254\354\230\244 \354\240\204\353\236\265\n            </span>\n          </nav>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <button className=\"px-4 py-2 border border-[#E2E8F0] rounded-lg text-[#002045] text-sm font-semibold hover:bg-slate-50 transition-colors\">\353\257\270\353\246\254\353\263\264\352\270\260</button>\n          <button className=\"px-4 py-2 bg-[#002045] text-white rounded-lg text-sm font-semibold hover:bg-opacity-90 shadow-sm transition-colors\">\353\260\234\355\226\211</button>\n        </div>\n      </header>\n\n      <div className=\"flex-1 flex overflow-hidden\">\n        {/* Left: AI Strategy Sidebar */}\n        <aside className=\"w-80 bg-white border-r border-[#E2E8F0] flex flex-col z-10 flex-shrink-0\">\n          <div className=\"p-4 border-b border-[#E2E8F0] bg-slate-50 flex items-center gap-3\">\n             <div className=\"w-8 h-8 rounded-full bg-[#1a365d] text-white flex items-center justify-center\">\n               <Bot size={16}/>\n             </div>\n             <div>\n               <h3 className=\"font-bold text-sm text-[#002045]\">AI \355\217\254\355\212\270\355\217\264\353\246\254\354\230\244 \354\240\204\353\236\265</h3>\n               <p className=\"text-[11px] text-[#64748b]\">TechNova 2024 \355\225\230\353\260\230\352\270\260 \352\263\265\354\261\204 \353\247\236\354\266\244</p>\n             </div>\n          </div>\n          <div className=\"p-5 flex flex-col gap-6 overflow-y-auto bg-slate-50 flex-1\">\n             <div>\n               <h3 className=\"text-sm font-bold text-[#002045] mb-3\">\353\260\260\354\271\230 \354\266\224\354\262\234 (\354\232\260\354\204\240\354\210\234\354\234\204)</h3>\n               <div className=\"space-y-3\">\n                 <div className=\"bg-white p-3 border border-[#38A169] rounded-lg shadow-sm relative\">\n                   <div className=\"absolute -left-2 -top-2 w-5 h-5 bg-[#38A169] text-white rounded-full flex items-center justify-center text-xs font-bold shadow-sm\">1</div>\n                   <span className=\"text-xs font-bold text-[#38A169] bg-[#38A169]/10 px-2 py-0.5 rounded mb-2 inline-block\">\355\225\204\354\202\264\352\270\260</span>\n                   <p className=\"text-sm font-bold text-[#002045]\">\355\224\204\353\241\234\354\240\235\355\212\270 A (\354\204\234\353\271\204\354\212\244 \352\270\260\355\232\215)</p>\n                   <p className=\"text-xs text-[#64748b] mt-1\">JD\354\235\230 \355\225\265\354\213\254 \354\232\224\352\265\254\354\202\254\355\225\255\354\235\270 \'\354\275\230\355\205\220\354\270\240 \352\270\260\355\232\215\'\352\263\274 \354\240\225\355\231\225\355\236\210 \354\235\274\354\271\230\355\225\251\353\213\210\353\213\244. \354\262\253 \354\236\245\354\227\220 \353\260\260\354\271\230\355\225\230\354\204\270\354\232\224.</p>\n                 </div>\n                 <div className=\"bg-white p-3 border border-[#E2E8F0] rounded-lg shadow-sm relative\">\n                   <div className=\"absolute -left-2 -top-2 w-5 h-5 bg-slate-200 text-[#002045] rounded-full flex items-center justify-center text-xs font-bold shadow-sm\">2</div>\n                   <span className=\"text-xs font-bold text-[#64748b] bg-slate-100 px-2 py-0.5 rounded mb-2 inline-block\">\353\271\214\354\202\264\352\270\260</span>\n                   <p className=\"text-sm font-bold text-[#002045]\">\355\224\204\353\241\234\354\240\235\355\212\270 B (\353\215\260\354\235\264\355\204\260 \353\266\204\354\204\235)</p>\n                   <p className=\"text-xs text-[#64748b] mt-1\">\'\353\215\260\354\235\264\355\204\260 \355\231\234\354\232\251\' \354\227\255\353\237\211\354\235\204 \353\263\264\354\241\260\354\240\201\354\234\274\353\241\234 \354\246\235\353\252\205\355\225\240 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244.</p>\n                 </div>\n               </div>\n             </div>\n             \n             <div className=\"h-px bg-[#E2E8F0]\"></div>\n             \n             <div>\n               <h3 className=\"text-sm font-bold text-[#002045] mb-3\">Gap Analysis (\353\266\200\354\241\261\355\225\234 \354\240\220)</h3>\n               <div className=\"bg-white p-3 border border-amber-300 rounded-lg shadow-sm relative\">\n                 <div className=\"flex items-center gap-2 mb-2\">\n                   <AlertTriangle size={16} className=\"text-amber-600\" />\n                   <span className=\"text-sm font-bold text-[#002045]\">IP \353\260\234\352\265\264 \352\262\275\355\227\230 \353\266\200\354\236\254</span>\n                 </div>\n                 <p className=\"text-xs text-amber-900 opacity-80 leading-relaxed\">\n                   \355\230\204\354\236\254 \354\236\220\353\243\214\354\227\220\354\204\234\353\212\224 IP \353\260\234\352\265\264\354\235\204 \354\247\201\354\240\221 \354\246\235\353\252\205\355\225\240 \352\267\274\352\261\260\352\260\200 \354\227\206\354\212\265\353\213\210\353\213\244. \352\270\260\354\241\264 \352\262\275\355\227\230\354\235\204 \354\226\265\354\247\200\353\241\234 \354\227\260\352\262\260\355\225\230\352\270\260\353\263\264\353\213\244, \n                   <strong>\354\275\230\355\205\220\354\270\240 \352\270\260\355\232\215/\353\254\270\354\240\234\354\240\225\354\235\230 \354\227\255\353\237\211</strong>\354\235\204 \354\262\253 \355\216\230\354\235\264\354\247\200\354\227\220\354\204\234 \353\215\224 \352\260\225\355\225\230\352\262\214 \354\226\264\355\225\204\355\225\230\353\212\224 \352\262\203\354\235\204 \352\266\214\354\236\245\355\225\251\353\213\210\353\213\244.\n                 </p>\n               </div>\n             </div>\n          </div>\n        </aside>\n\n        {/* Center: Canvas */}\n        <main className=\"flex-1 bg-slate-100 overflow-y-auto p-8 flex justify-center items-start\">\n          <div className={`w-full max-w-4xl bg-white rounded-xl border border-[#E2E8F0] ${SHADOW} overflow-hidden min-h-[800px] flex flex-col`}>\n             <div className=\"h-10 bg-slate-50 border-b border-[#E2E8F0] flex items-center px-4 gap-2\">\n                <div className=\"w-3 h-3 rounded-full bg-red-400\"></div>\n                <div className=\"w-3 h-3 rounded-full bg-amber-400\"></div>\n                <div className=\"w-3 h-3 rounded-full bg-green-400\"></div>\n                <div className=\"flex-1 text-center text-xs text-[#64748b] font-medium opacity-70\">\354\212\254\353\235\274\354\235\264\353\223\234 1 / 5</div>\n             </div>\n             \n             <div className=\"p-16 flex flex-col gap-12 text-center flex-1 relative group cursor-text\">\n                <div className=\"absolute inset-0 border-2 border-dashed border-transparent group-hover:border-[#E2E8F0] m-4 rounded-xl transition-colors pointer-events-none\"></div>\n                <div className=\"my-auto\">\n                  <h1 className=\"text-5xl font-bold text-[#002045] mb-6 tracking-tight\">\355\231\215\352\270\270\353\217\231</h1>\n                  <p className=\"text-xl text-[#64748b] max-w-2xl mx-auto leading-relaxed\">\353\252\251\354\240\201\352\263\274 \354\240\225\353\260\200\355\225\250\354\234\274\353\241\234 \353\224\224\354\247\200\355\204\270 \352\262\275\355\227\230\354\235\204 \354\240\234\354\236\221\355\225\230\353\212\224 \354\204\240\354\236\204 UX/UI \353\224\224\354\236\220\354\235\264\353\204\210\354\236\205\353\213\210\353\213\244.</p>\n                </div>\n             </div>\n          </div>\n        </main>\n\n        {/* Right: Elements Sidebar */}\n        <aside className=\"w-64 bg-white border-l border-[#E2E8F0] flex flex-col z-10 flex-shrink-0\">\n          <div className=\"p-4 border-b border-[#E2E8F0]\">\n            <h2 className=\"text-xs font-bold text-[#64748b] uppercase tracking-wider\">\354\232\224\354\206\214 \354\266\224\352\260\200</h2>\n          </div>\n          <div className=\"p-4 flex flex-col gap-3 overflow-y-auto\">\n            {[\n              { icon: Type, label: \'\355\205\215\354\212\244\355\212\270 \353\270\224\353\241\235\' },\n              { icon: ImageIcon, label: \'\354\235\264\353\257\270\354\247\200\' },\n              { icon: LayoutGrid, label: \'\355\224\204\353\241\234\354\240\235\355\212\270 \352\267\270\353\246\254\353\223\234\' },\n              { icon: Award, label: \'\354\212\244\355\202\254 \353\260\260\354\247\200\' },\n            ].map((el, i) => (\n              <div key={i} className=\"flex flex-col gap-2 p-4 bg-white border border-[#E2E8F0] rounded-lg cursor-grab hover:border-[#1a365d] hover:shadow-sm transition-all group\">\n                <el.icon size={20} className=\"text-[#1a365d] opacity-80 group-hover:opacity-100\" />\n                <span className=\"text-sm font-semibold text-[#002045]\">{el.label}</span>\n              </div>\n            ))}\n          </div>\n        </aside>\n      </div>\n    </div>\n  );\n};\n\n// --- Main App Component ---"
    }
