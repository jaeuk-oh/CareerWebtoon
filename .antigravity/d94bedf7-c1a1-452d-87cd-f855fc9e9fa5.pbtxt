  user_input {
    user_response: "\354\225\204\353\236\230 prd\353\245\274 \353\252\250\353\221\220 \353\260\230\354\230\201\355\225\230\352\263\240, \355\225\204\354\232\224\355\225\230\353\213\244\353\251\264 \353\246\254\353\224\224\354\236\220\354\235\270\353\217\204 \354\247\204\355\226\211\355\225\264\353\235\274. \352\267\270\353\246\254\352\263\240 \353\260\230\354\230\201\353\213\250\352\263\204\353\245\274 \355\225\255\354\203\201 visualize\355\225\264\353\235\274. \n\n\n----------- prd -------------\n\352\270\260\354\241\264\354\227\220 \354\203\235\352\260\201\355\226\210\353\215\230 **\342\200\234JD \353\204\243\354\234\274\353\251\264 \354\236\220\354\206\214\354\204\234 \354\215\250\354\243\274\353\212\224 AI\342\200\235**\354\227\220\354\204\234 \355\225\234 \353\213\250\352\263\204 \353\215\224 \353\202\230\354\225\204\352\260\200\354\204\234,\n\n> **\354\202\254\354\232\251\354\236\220\352\260\200 \354\235\264\353\257\270 \352\260\200\354\247\204 \352\262\275\355\227\230\302\267\354\236\220\354\206\214\354\204\234\302\267\355\217\254\355\212\270\355\217\264\353\246\254\354\230\244\353\245\274 \354\236\220\354\202\260\355\231\224\355\225\230\352\263\240, \354\247\200\354\233\220 \354\247\201\353\254\264\354\227\220 \353\247\236\353\212\224 \354\206\214\354\236\254\353\245\274 \354\204\240\353\263\204\355\225\234 \353\222\244, \354\202\254\354\213\244\354\204\261\302\267\354\240\225\353\237\211\354\204\261\302\267\354\247\201\353\254\264 \354\240\201\355\225\251\354\204\261\302\267\353\251\264\354\240\221 \353\260\251\354\226\264\353\240\245\352\271\214\354\247\200 \352\262\200\354\246\235\355\225\230\353\251\264\354\204\234 \353\254\270\354\204\234\353\245\274 \354\236\254\352\265\254\354\204\261\355\225\230\353\212\224 AI \354\267\250\354\227\205 \354\275\224\355\214\214\354\235\274\353\237\277**\n\n\354\234\274\353\241\234 \354\240\225\354\235\230\355\225\230\353\212\224 \352\262\214 \353\247\236\353\213\244.\n\n\355\212\271\355\236\210 \353\204\244\352\260\200 \354\244\200 \354\236\220\353\243\214\354\227\220\354\204\234 \354\244\221\354\232\224\355\225\234 \352\261\264 **3C4P / \355\225\204\354\202\264\352\270\260\302\267\353\260\211\354\202\264\352\270\260\302\267\353\271\214\354\202\264\352\270\260 / INPUT\302\267OUTPUT / \354\233\220\353\263\270 \354\210\253\354\236\220 / \353\251\264\354\240\221 \353\260\251\354\226\264\354\204\261**\354\235\204 \353\213\250\354\210\234 \355\224\204\353\241\254\355\224\204\355\212\270\354\227\220 \353\204\243\353\212\224 \352\262\214 \354\225\204\353\213\210\353\235\274 **\354\204\234\353\271\204\354\212\244\354\235\230 \353\215\260\354\235\264\355\204\260 \353\252\250\353\215\270\352\263\274 \355\217\211\352\260\200 \353\241\234\354\247\201 \354\236\220\354\262\264\354\227\220 \353\205\271\354\235\264\353\212\224 \352\262\203**\354\235\264\353\213\244.\n\n\354\225\204\353\236\230\353\245\274 **\354\265\234\354\242\205 PRD v1.0**\354\234\274\353\241\234 \354\236\241\353\212\224 \352\261\270 \354\266\224\354\262\234\355\225\234\353\213\244.\n\n---\n\n# AI \354\267\250\354\227\205 \354\275\224\355\214\214\354\235\274\353\237\277 \342\200\224 \354\265\234\354\242\205 PRD v1.0\n\n## 0. Product Definition\n\n### \354\204\234\353\271\204\354\212\244 \355\225\234 \354\244\204\n\n> **\353\202\264 \352\262\275\355\227\230\354\235\204 \353\266\204\354\204\235\355\225\230\352\263\240, \354\247\200\354\233\220 \354\247\201\353\254\264\354\227\220 \353\247\236\353\212\224 \354\206\214\354\236\254\353\245\274 \354\260\276\354\225\204, \353\251\264\354\240\221\354\227\220\354\204\234 \353\260\251\354\226\264 \352\260\200\353\212\245\355\225\234 \354\236\220\354\206\214\354\204\234\354\231\200 \355\217\254\355\212\270\355\217\264\353\246\254\354\230\244\353\241\234 \353\247\214\353\223\244\354\226\264\354\243\274\353\212\224 AI \354\267\250\354\227\205 \354\275\224\355\214\214\354\235\274\353\237\277**\n\n### \355\225\265\354\213\254 \353\254\270\354\240\234\n\n\355\230\204\354\236\254 AI \354\236\220\354\206\214\354\204\234 \354\204\234\353\271\204\354\212\244\353\212\224 \353\214\200\354\262\264\353\241\234\n\n```text\nJD \354\236\205\353\240\245\n\342\206\223\n\354\236\220\354\206\214\354\204\234 \354\203\235\354\204\261\n```\n\n\354\227\220 \354\247\221\354\244\221\355\225\234\353\213\244.\n\n\355\225\230\354\247\200\353\247\214 \354\213\244\354\240\234 \354\267\250\354\227\205\354\227\220\354\204\234 \354\226\264\353\240\244\354\232\264 \352\262\203\354\235\200 \352\270\200\354\235\204 \353\247\214\353\223\234\353\212\224 \352\262\203\354\235\264 \354\225\204\353\213\210\353\213\244.\n\n```text\n\353\202\264 \352\262\275\355\227\230 \354\244\221 \353\254\264\354\227\207\354\235\264 \354\242\213\354\235\200 \354\206\214\354\236\254\354\235\270\352\260\200?\n        \342\206\223\n\354\235\264 \354\247\201\353\254\264\354\227\220\354\204\234 \354\226\264\353\226\244 \352\262\275\355\227\230\354\235\264 \352\260\200\354\236\245 \352\260\225\355\225\234\352\260\200?\n        \342\206\223\n\352\267\270 \352\262\275\355\227\230\354\235\204 \354\226\264\353\226\273\352\262\214 \352\265\254\354\241\260\355\231\224\355\225\240 \352\262\203\354\235\270\352\260\200?\n        \342\206\223\n\354\210\253\354\236\220\354\231\200 \354\204\261\352\263\274\353\212\224 \354\213\244\354\240\234 \352\267\274\352\261\260\352\260\200 \354\236\210\353\212\224\352\260\200?\n        \342\206\223\n\352\263\274\354\236\245 \354\227\206\354\235\264 \354\226\274\353\247\210\353\202\230 \352\260\225\355\225\230\352\262\214 \355\221\234\355\230\204\355\225\240 \354\210\230 \354\236\210\353\212\224\352\260\200?\n        \342\206\223\n\353\251\264\354\240\221\352\264\200\354\235\264 \354\260\214\353\245\264\353\251\264 \353\260\251\354\226\264\355\225\240 \354\210\230 \354\236\210\353\212\224\352\260\200?\n```\n\n\353\224\260\353\235\274\354\204\234 \353\263\270 \354\204\234\353\271\204\354\212\244\353\212\224 **Writing AI\352\260\200 \354\225\204\353\213\210\353\235\274 Evidence-based Application AI**\353\245\274 \354\247\200\355\226\245\355\225\234\353\213\244.\n\n---\n\n# 1. \355\225\265\354\213\254 \354\262\240\355\225\231\n\n\354\204\234\353\271\204\354\212\244 \354\240\204\354\262\264\353\245\274 \352\264\200\355\206\265\355\225\230\353\212\224 5\352\260\200\354\247\200 \354\233\220\354\271\231.\n\n### Principle 1. \352\262\275\355\227\230\354\235\200 \354\203\235\354\204\261\355\225\230\354\247\200 \354\225\212\353\212\224\353\213\244\n\n> **\354\227\206\353\212\224 \352\262\275\355\227\230\354\235\204 \353\247\214\353\223\244\354\247\200 \354\225\212\353\212\224\353\213\244.**\n\nAI\353\212\224 \354\202\254\354\232\251\354\236\220\352\260\200 \354\240\234\352\263\265\355\225\234 \354\202\254\354\213\244\354\235\204 \354\236\254\352\265\254\354\204\261\355\225\240 \354\210\230 \354\236\210\354\247\200\353\247\214,\n\n* \355\225\230\354\247\200 \354\225\212\354\235\200 \355\224\204\353\241\234\354\240\235\355\212\270\n* \352\262\275\355\227\230\355\225\230\354\247\200 \354\225\212\354\235\200 \354\227\205\353\254\264\n* \354\270\241\354\240\225\355\225\230\354\247\200 \354\225\212\354\235\200 \354\204\261\352\263\274\n* \354\213\244\354\240\234\353\241\234 \355\225\230\354\247\200 \354\225\212\354\235\200 \354\241\260\354\202\254\n* \354\241\264\354\236\254\355\225\230\354\247\200 \354\225\212\353\212\224 \354\210\253\354\236\220\n\n\353\245\274 \353\247\214\353\223\244\354\226\264\353\202\264\353\251\264 \354\225\210 \353\220\234\353\213\244.\n\n---\n\n### Principle 2. \352\262\275\355\227\230\354\235\230 \352\260\200\354\271\230\353\212\224 \354\247\201\353\254\264\354\227\220 \353\224\260\353\235\274 \353\213\254\353\235\274\354\247\204\353\213\244\n\n```text\nExperience Value\n=\nExperience \303\227 Target Job\n```\n\n\352\260\231\354\235\200 \352\262\275\355\227\230\354\235\264\353\235\274\353\217\204\n\n```text\nAI \354\236\220\353\217\231\355\231\224 \355\224\204\353\241\234\354\240\235\355\212\270\n\342\206\222 AX \354\247\201\353\254\264 : \355\225\204\354\202\264\352\270\260\n\342\206\222 \354\275\230\355\205\220\354\270\240 PD : \355\231\234\354\232\251 \352\260\200\353\212\245 \354\206\214\354\236\254\n\342\206\222 \355\232\214\352\263\204 \354\247\201\353\254\264 : \353\263\264\354\241\260 \354\206\214\354\236\254\n```\n\n\352\260\200 \353\220\240 \354\210\230 \354\236\210\353\213\244.\n\n\353\224\260\353\235\274\354\204\234 **\352\262\275\355\227\230 \354\236\220\354\262\264\353\245\274 \355\217\211\352\260\200\355\225\230\354\247\200 \354\225\212\352\263\240 JD\354\231\200\354\235\230 \352\264\200\352\263\204\354\227\220\354\204\234 \355\217\211\352\260\200**\355\225\234\353\213\244.\n\n---\n\n### Principle 3. \354\236\220\354\206\214\354\204\234\353\212\224 \352\270\200\354\223\260\352\270\260\353\263\264\353\213\244 \353\260\251\354\226\264 \354\204\244\352\263\204\353\213\244\n\n\353\252\250\353\223\240 \355\225\265\354\213\254 \353\254\270\354\236\245\354\235\200 \353\213\244\354\235\214 \354\247\210\353\254\270\354\235\204 \355\206\265\352\263\274\355\225\264\354\225\274 \355\225\234\353\213\244.\n\n```text\n\354\226\264\353\226\273\352\262\214 \355\226\210\353\202\230\354\232\224?\n\354\226\274\353\247\210\353\202\230 \355\226\210\353\202\230\354\232\224?\n\353\254\264\354\212\250 \352\267\274\352\261\260\354\235\270\352\260\200\354\232\224?\n\354\231\234 \352\267\270\353\240\207\352\262\214 \355\214\220\353\213\250\355\226\210\353\202\230\354\232\224?\n\353\263\270\354\235\270\354\235\264 \354\247\201\354\240\221 \355\225\234 \352\261\264 \353\254\264\354\227\207\354\235\270\352\260\200\354\232\224?\n```\n\n\353\213\265\355\225\240 \354\210\230 \354\227\206\353\213\244\353\251\264 \355\221\234\355\230\204\354\235\204 \353\202\256\354\266\224\352\261\260\353\202\230 \354\240\234\352\261\260\355\225\234\353\213\244.\n\n---\n\n### Principle 4. \354\210\253\354\236\220\353\212\224 \352\260\225\355\225\230\352\262\214\352\260\200 \354\225\204\353\213\210\353\235\274 \354\240\225\355\231\225\355\225\230\352\262\214\n\n```text\nINPUT\n\342\206\222 \354\213\244\354\240\234 \352\267\234\353\252\250/\352\267\274\352\261\260\n\342\206\222 \354\270\241\354\240\225\353\220\234 \354\202\254\354\213\244\354\235\264\353\251\264 \354\202\254\354\232\251 \352\260\200\353\212\245\n\nOUTPUT\n\342\206\222 \354\204\261\352\263\274/\355\232\250\352\263\274\n\342\206\222 \354\213\244\354\240\234 \354\270\241\354\240\225\353\220\234 \352\262\275\354\232\260\354\227\220\353\247\214 \354\202\254\354\232\251\n```\n\n\355\212\271\355\236\210:\n\n```text\n15\352\261\264 \342\206\222 21\352\261\264\n```\n\n\354\235\264\n\n```text\n40% \354\246\235\352\260\200\n```\n\n\353\263\264\353\213\244 \354\232\260\354\204\240\355\225\234\353\213\244.\n\n---\n\n### Principle 5. AI\354\235\230 \354\240\234\354\225\210\354\235\204 \354\202\254\354\213\244\353\263\264\353\213\244 \354\232\260\354\204\240\355\225\230\354\247\200 \354\225\212\353\212\224\353\213\244\n\nAI\352\260\200\n\n> \"\355\232\250\354\234\250\354\204\261\354\235\204 30% \352\260\234\354\204\240\355\226\210\353\213\244\352\263\240 \355\221\234\355\230\204\355\225\230\354\204\270\354\232\224.\"\n\n\353\235\274\352\263\240 \355\225\264\353\217\204 \354\213\244\354\240\234 \354\270\241\354\240\225\355\225\230\354\247\200 \354\225\212\354\225\230\353\213\244\353\251\264:\n\n```text\n\342\235\214 30% \352\260\234\354\204\240\n```\n\n\354\235\264\353\213\244.\n\nAI\354\235\230 \354\227\255\355\225\240\354\235\200 **\354\202\254\354\213\244\354\235\204 \352\260\225\355\231\224\355\225\230\353\212\224 \352\262\203**\354\235\264\354\247\200 **\354\202\254\354\213\244\354\235\204 \353\247\214\353\223\244\354\226\264\353\202\264\353\212\224 \352\262\203**\354\235\264 \354\225\204\353\213\210\353\213\244.\n\n---\n\n# 2. Target User\n\n### Primary\n\n\354\267\250\354\227\205 \354\244\200\353\271\204\354\203\235 / \354\213\240\354\236\205 \354\247\200\354\233\220\354\236\220\n\n\355\212\271\355\236\210:\n\n* \354\236\220\354\206\21