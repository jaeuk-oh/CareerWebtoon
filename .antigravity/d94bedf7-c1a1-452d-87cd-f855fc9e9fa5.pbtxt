          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (view === \'pipeline\') setLoadingMsg(\'Candidate Vault\353\245\274 \353\266\210\353\237\254\354\230\244\353\212\224 \354\244\221...\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    else if (view === \'editor\') setLoadingMsg(\'Evidence Validator \354\213\244\355\226\211 \354\244\221...\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    else setLoadingMsg(\'\353\266\210\353\237\254\354\230\244\353\212\224 \354\244\221...\');"
