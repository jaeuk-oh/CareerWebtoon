        }
        lines {
          text: "              <h2 className=\"text-2xl font-bold border-b border-[#E2E8F0] pb-2 mb-6\">1. \354\247\200\354\233\220 \354\247\201\353\254\264\354\231\200 \352\264\200\353\240\250\353\220\234 \355\225\265\354\213\254 \355\224\204\353\241\234\354\240\235\355\212\270 \352\262\275\355\227\230</h2>"
