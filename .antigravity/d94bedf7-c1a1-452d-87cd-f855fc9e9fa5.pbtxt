steps {
  type: CORTEX_STEP_TYPE_USER_INPUT
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1785732802
      nanos: 716489523
    }
    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
  }
  user_input {
    user_response: "\354\242\213\354\225\204. \354\247\200\352\270\210\352\271\214\354\247\200 \353\202\230\354\230\250 \353\202\264\354\232\251\354\235\204 \352\270\260\354\244\200\354\234\274\353\241\234 **\354\204\234\353\271\204\354\212\244\354\235\230 \354\262\240\355\225\231 \342\206\222 \353\254\270\354\204\234\353\263\204 \354\227\255\355\225\240 \342\206\222 \354\202\254\354\232\251\354\236\220 \355\235\220\353\246\204 \342\206\222 AI \353\266\204\354\204\235/\354\266\224\354\262\234 \342\206\222 \354\236\221\354\204\261/\354\262\250\354\202\255 \342\206\222 \352\262\200\354\246\235 \342\206\222 \352\270\260\354\210\240 \354\225\204\355\202\244\355\205\215\354\262\230 \342\206\222 MVP \353\262\224\354\234\204**\352\271\214\354\247\200 \355\225\230\353\202\230\353\241\234 \355\225\251\354\271\234 \354\265\234\354\242\205 PRD\353\241\234 \354\240\225\353\246\254\355\225\234\353\213\244.\n\n# AI \354\267\250\354\227\205 \354\275\224\355\214\214\354\235\274\353\237\277 \354\265\234\354\242\205 PRD v1.0\n\n## 1. Product Overview\n\n### \354\204\234\353\271\204\354\212\244 \355\225\234 \354\244\204\n\n> **\353\202\264 \352\262\275\355\227\230\354\235\204 \354\247\201\353\254\264\354\227\220 \353\247\236\353\212\224 \352\260\225\355\225\234 \352\267\274\352\261\260\353\241\234 \353\260\224\352\276\270\352\263\240, \354\235\264\353\240\245\354\204\234\302\267\352\262\275\353\240\245\352\270\260\354\210\240\354\204\234\302\267\354\236\220\354\206\214\354\204\234\302\267\355\217\254\355\212\270\355\217\264\353\246\254\354\230\244\353\245\274 \352\260\201\352\260\201\354\235\230 \353\252\251\354\240\201\354\227\220 \353\247\236\352\262\214 \354\231\204\354\204\261\355\225\230\353\217\204\353\241\235 \353\217\225\353\212\224 AI \354\267\250\354\227\205 \354\275\224\355\214\214\354\235\274\353\237\277**\n\n### \355\225\265\354\213\254 \354\262\240\355\225\231\n\n> **AI\352\260\200 \354\227\206\353\212\224 \352\262\275\355\227\230\354\235\204 \353\247\214\353\223\244\354\226\264\354\243\274\353\212\224 \352\262\203\354\235\264 \354\225\204\353\213\210\353\235\274, \353\202\264\352\260\200 \354\235\264\353\257\270 \352\260\200\354\247\204 \352\262\275\355\227\230\354\227\220\354\204\234 \352\260\200\354\236\245 \352\260\225\355\225\234 \354\235\264\354\225\274\352\270\260\353\245\274 \354\260\276\354\225\204\354\244\200\353\213\244.**\n\n\352\267\270\353\246\254\352\263\240 \354\265\234\354\242\205\354\240\201\354\235\270 \355\214\220\353\213\250 \352\270\260\354\244\200\354\235\200 \355\225\230\353\202\230\353\213\244.\n\n> **\"\353\251\264\354\240\221\352\264\200\354\235\264 \354\235\264 \353\254\270\354\236\245\354\235\204 \354\260\224\353\240\200\354\235\204 \353\225\214 \353\202\264\352\260\200 \353\213\265\355\225\240 \354\210\230 \354\236\210\353\212\224\352\260\200?\"**\n\n---\n\n# 2. \355\225\264\352\262\260\355\225\230\353\240\244\353\212\224 \353\254\270\354\240\234\n\n\355\230\204\354\236\254 AI \354\267\250\354\227\205 \354\204\234\353\271\204\354\212\244\353\212\224 \353\214\200\353\266\200\353\266\204 \353\213\244\354\235\214\352\263\274 \352\260\231\353\213\244.\n\n```text\nJD \354\236\205\353\240\245\n+\n\353\202\264 \354\236\220\354\206\214\354\204\234 \354\236\205\353\240\245\n\342\206\223\nAI\352\260\200 \354\236\220\354\206\214\354\204\234 \354\203\235\354\204\261/\354\262\250\354\202\255\n```\n\n\355\225\230\354\247\200\353\247\214 \354\213\244\354\240\234 \354\247\200\354\233\220\354\236\220\352\260\200 \354\226\264\353\240\244\354\233\214\355\225\230\353\212\224 \352\262\203\354\235\200 \353\254\270\354\236\245 \354\236\221\354\204\261 \354\236\220\354\262\264\352\260\200 \354\225\204\353\213\210\353\213\244.\n\n### \354\213\244\354\240\234 \353\254\270\354\240\234\n\n1. \353\202\264 \352\262\275\355\227\230 \354\244\221 \354\226\264\353\226\244 \352\262\203\354\235\264 \354\242\213\354\235\200 \354\206\214\354\236\254\354\235\270\354\247\200 \353\252\250\353\245\270\353\213\244.\n2. \352\260\231\354\235\200 \352\262\275\355\227\230\354\235\204 \354\226\264\353\212\220 \354\247\201\353\254\264\354\227\220 \354\215\250\354\225\274 \355\225\240\354\247\200 \353\252\250\353\245\270\353\213\244.\n3. \354\235\264\353\240\245\354\204\234\354\231\200 \354\236\220\354\206\214\354\204\234\354\231\200 \355\217\254\355\212\270\355\217\264\353\246\254\354\230\244\354\235\230 \354\227\255\355\225\240\354\235\204 \355\230\274\353\217\231\355\225\234\353\213\244.\n4. \352\262\275\355\227\230\354\235\204 \354\247\201\353\254\264\354\231\200 \354\227\260\352\262\260\355\225\230\353\212\224 \352\263\274\354\240\225\354\235\264 \354\226\264\353\240\265\353\213\244.\n5. AI\352\260\200 \353\247\214\353\223\244\354\226\264\354\244\200 \354\210\253\354\236\220\353\202\230 \354\204\261\352\263\274\353\245\274 \352\267\270\353\214\200\353\241\234 \354\202\254\354\232\251\355\225\230\352\270\260 \354\211\275\353\213\244.\n6. \354\236\220\354\206\214\354\204\234\353\212\224 \352\267\270\353\237\264\353\223\257\355\225\230\354\247\200\353\247\214 \353\251\264\354\240\221\354\227\220\354\204\234 \354\204\244\353\252\205\355\225\240 \354\210\230 \354\227\206\353\212\224 \352\262\275\354\232\260\352\260\200 \353\247\216\353\213\244.\n7. JD\353\247\210\353\213\244 \354\226\264\353\226\244 \352\262\275\355\227\230\354\235\204 \352\272\274\353\202\264\354\225\274 \355\225\230\353\212\224\354\247\200 \353\213\244\354\213\234 \355\214\220\353\213\250\355\225\264\354\225\274 \355\225\234\353\213\244.\n8. \352\270\260\354\241\264 \354\236\220\353\243\214\352\260\200 \354\236\210\353\212\224\353\215\260 \353\247\244\353\262\210 \354\262\230\354\235\214\353\266\200\355\204\260 \354\236\221\354\204\261\355\225\234\353\213\244.\n\n\353\224\260\353\235\274\354\204\234 \354\235\264 \354\204\234\353\271\204\354\212\244\353\212\224 **\"\353\254\270\354\204\234 \354\203\235\354\204\261\352\270\260\"\352\260\200 \354\225\204\353\213\210\353\235\274 \"\352\262\275\355\227\230 \342\206\222 \354\247\201\353\254\264 \342