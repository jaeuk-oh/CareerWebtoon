# NVIDIA API Catalog
NVIDIA_API_KEY=nvapi-xxx
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Use the Supavisor pooler host (direct db.<ref>.supabase.co is IPv6-only on new projects).
# Role must exist in Postgres with LOGIN + BYPASSRLS (see backend/supabase/schema.sql).
DATABASE_URL=postgresql+asyncpg://app_role.xxx:password@aws-0-<region>.pooler.supabase.com:6543/postgres

# App
DEBUG=true
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
